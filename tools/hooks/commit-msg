#!/bin/sh
# Copied from ~/.claude/tools/commit-msg -- the source. Keep in sync;
# fix drift the moment you notice it. Install with `make hooks`.
# Commit message checks, following kernel practice.
#
# The copy that runs lives in .git/hooks, which is untracked; this one is in
# the tree so it is reviewable, survives a clone, and can be diffed against
# its siblings. `make hooks` installs it. Bypass with `git commit
# --no-verify`, which is at least a decision rather than an accident.
#
# Two rules, and only two. An earlier version of this hook also rejected a
# trailing period and any `word:` prefix, neither of which was ever asked
# for, and rejected Signed-off-by, which is wanted -- it is the Developer
# Certificate of Origin, and what a reviewer adds when taking responsibility
# for a change.

msg="$1"

# `\b` on the phrase and not on the names, which is the difference between
# the two kinds of term here. The names are matched as substrings on purpose
# -- a vendor word at the end of a path under the tree is still an
# attribution, which was measured rather than assumed. `generated with` is
# not a name, it is English, and unanchored it matched inside `regenerated
# with`, refusing a message describing a header emitted a second time. A
# gate that refuses ordinary prose is one somebody works around.
TOOLING='\bgenerated with|claude|anthropic|copilot|chatgpt|noreply@anthropic'

# What the prose check reads, and it is deliberately not the whole file.
#
# Two things are removed, for two different reasons.
#
# First, everything git is going to throw away: comment lines, and the diff
# below the scissors line that `git commit -v` appends. Checking those
# refuses a commit over text that will never be in it, and the case is not
# hypothetical -- a change to THIS FILE shows its own vendor list in the
# diff, so the hook refused every commit that edited it. (A message kept
# with --cleanup=verbatim would retain comment lines; that is the one shape
# where this is more lenient than the stored message.)
#
# Second, the names of the shared tooling tree. Without this no commit could
# say where these files come from: this hook lives at
# ~/.claude/tools/commit-msg, the style gate beside it, and the guidelines
# under ~/.claude/guidelines/. Naming one read as a "tooling reference" --
# the rule firing on the one use it was never meant to cover, where the
# workaround is to describe a path instead of writing it, making the log
# vaguer exactly where it is trying to be exact.
#
# What is spared is exactly three NAMES: the directory `.claude`, written
# with its leading dot; the file `CLAUDE.md`; and `claude-guidelines`, the
# repository the guidelines live in. None is a plausible spelling of
# attribution -- nobody credits a tool as ".claude" -- while all three are
# unavoidable when writing about these files. The bare vendor word on its
# own is untouched and still refused.
#
# The third arrived the way the first two did: a commit reconciling a
# project style file against its source could not name the repository the
# source is in, and the message had to say "the repository holding it"
# instead. A rule that makes the log vaguer where it is trying to be exact
# is the rule misfiring, not the message.
#
# Only those names are neutralised, never the token around them. Stripping
# whole path-shaped tokens instead would forgive anything hidden inside one,
# and a trailer naming a vendor as the last element of a path under the tree
# then passed; that was measured, and is why this is narrow.
#
# The trailer check below is deliberately left reading the raw message: it
# keys on the trailer NAME rather than on any vendor, so a generated-by
# trailer with any path at all is still refused.
# `claude-guidelines` is substituted before `.claude` so that the longer
# name cannot be left half-scrubbed by the shorter one if either is edited
# later. Neither matches the other today; the ordering is a guard, not a
# fix.
#
# Two variables come out of this, and the difference matters. `body` is the
# message as it will be stored, minus what git discards. `prose` is that with
# the names above neutralised, which is what the vendor checks read -- and is
# the wrong thing to measure a column count against, since every substitution
# here makes the line longer than the one somebody wrote.
body=$(sed -e '/^#.*>8/,$d' -e '/^#/d' "$msg")
prose=$(printf '%s\n' "$body" \
	| sed -E 's#claude-guidelines#tooling-guidelines#g; s#\.claude#.tooling#g; s#CLAUDE\.md#guidelines.md#g')

# 1. No AI or tooling attribution. The single deviation from kernel practice,
#    and it is absolute. Human co-authors and reviewers are fine; a generator
#    is not an author and does not sign anything.
if grep -qiE '^[[:space:]]*(assisted-by|generated-by|co-developed-by)[[:space:]]*:.*(claude|anthropic|copilot|chatgpt|gpt|gemini|llm|ai)\b' "$msg" \
	|| grep -qiE '^[[:space:]]*(assisted-by|generated-by)[[:space:]]*:' "$msg"; then
	echo "commit-msg: generator attribution trailer. A tool is not an author." >&2
	grep -inE '^[[:space:]]*(assisted-by|generated-by|co-developed-by)[[:space:]]*:' "$msg" >&2
	exit 1
fi

if printf '%s\n' "$prose" | grep -qiE "$TOOLING"; then
	echo "commit-msg: tooling reference in the message." >&2
	# Reported from the scrubbed text on purpose: the line is shown as the
	# check read it, so what is left highlighted is the actual reason, not a
	# path that was already forgiven.
	printf '%s\n' "$prose" | grep -inE "$TOOLING" >&2
	exit 1
fi

# Columns, which is not the same as bytes.
#
# `${#var}` counts BYTES in dash, which is what /bin/sh is here. That reads
# the same as a column count for ASCII and stops being one the moment a
# message uses an em dash or an ellipsis: a 75-column line carrying one `...`
# measures 77 and was refused. Eight of hydra's commits were rejected that
# way, every one of them exactly 75 columns and correct -- the limit exists so
# prose fits a terminal, and a character three bytes wide still occupies one
# column.
#
# Rewrapping prose to satisfy that would be the defect being propagated
# rather than fixed, so the count is fixed instead. Stripping UTF-8
# continuation bytes (0x80-0xBF) leaves one byte per character, which is the
# character count without needing a locale to be set -- `wc -m` would answer
# correctly only where the environment happens to say UTF-8, and a hook runs
# in whatever environment git was invoked from.
#
# The byte length is kept as a cheap pre-filter: it is never smaller than the
# column count, so a line within 75 bytes needs no further measuring, and only
# a suspect line pays for a subprocess.
columns() {
	printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c
}

# 2. Subject at 75 columns, the kernel's limit, taken deliberately: it is what
#    keeps `git log --oneline` and `git shortlog` readable at a terminal width.
subject=$(sed -n '1p' "$msg")
case "$subject" in
	'#'*) exit 0 ;;
esac
if [ "${#subject}" -gt 75 ] && [ "$(columns "$subject")" -gt 75 ]; then
	echo "commit-msg: subject is $(columns "$subject") columns, limit is 75." >&2
	echo "commit-msg:   $subject" >&2
	exit 1
fi

# 3. Body lines at the same 75 columns, for the same reason: the log is read in
#    a terminal. This was the stated convention long before anything enforced
#    it, and only the subject was checked -- so a body line at 76 sailed
#    through while a subject at 76 was refused.
#
# Measured in columns by `columns()` above, exactly as the subject is, so the
# two checks cannot disagree about what a column is.
#
# **Three kinds of line are exempt, and each is a rule rather than a
# concession.**
#
#   - A trailer. `Never wrap a trailer, whatever its length`: git parses the
#     block one line at a time, so a `Link:` broken in two stops being a
#     trailer at all and every tool that reads them silently misses it. Kernel
#     `Link:` lines routinely run well past 75 and are left alone.
#   - A line holding a url. A wrapped link is not clickable, often cannot be
#     reassembled, and leaves the reader guessing whether the trailing
#     punctuation belongs to it. The limit exists so prose stays readable, and
#     a url is not prose.
#   - An indented line, which is how a message carries something it is
#     quoting -- a compiler error, a stack trace, a snippet of output.
#     Reflowing quoted material to fit corrupts it.
#
# A trailer is recognised by its name rather than by a list, so one that has
# not come up yet is exempt on the same terms as `Fixes:` and `Link:`.
#
# **The blind spot is named rather than pretended away.** A line of prose
# opening `Note:` is indistinguishable from a trailer to any rule keyed on the
# name, and the guidelines settle what a trailer is by asking whether it names
# a person or an artifact -- which this cannot know. So it forgives that line.
# That is the right direction to be wrong in: the cost of forgiving one long
# prose line is a long prose line, while the cost of refusing a legitimate
# `Link:` is somebody wrapping it, at which point git stops parsing it as a
# trailer and every tool that reads them misses it silently.
long=""
n=0
while IFS= read -r line; do
	n=$((n + 1))
	[ "$n" -eq 1 ] && continue		# the subject, checked above
	[ "${#line}" -gt 75 ] || continue	# bytes: an upper bound on columns
	case "$line" in
		' '*|'	'*) continue ;;		# quoted, not prose
		*://*) continue ;;		# carries a url
	esac
	head=${line%%:*}
	if [ "$head" != "$line" ]; then
		case "$head" in
			'' | *[!A-Za-z-]*) ;;	# not a trailer name
			*) continue ;;		# `Fixes:`, `Link:`, `Signed-off-by:` ...
		esac
	fi
	width=$(columns "$line")
	[ "$width" -gt 75 ] || continue
	long="$long
commit-msg:   $n: $width columns: $line"
done <<EOF
$body
EOF

if [ -n "$long" ]; then
	echo "commit-msg: body line(s) past 75 columns." >&2
	printf '%s\n' "$long" | sed '/^$/d' >&2
	echo "commit-msg: wrap prose at 75. Trailers, urls and indented" >&2
	echo "commit-msg: (quoted) lines are exempt and need no wrapping." >&2
	exit 1
fi

exit 0
