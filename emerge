def eblock(msg):
	"""Print a (possibly multi-line) error with !!! on every line, so a
    wrapped list stays readable and no line looks unmarked."""
	for line in str(msg).split("\n"):
		print(f"{RED('!!!')} {line}")

def need_root():
	if os.geteuid() != 0:
		eerror("Superuser access is required... exiting.")
		sys.exit(1)

def run(cmd, **kw):
	return subprocess.run(cmd, text=True, **kw)

def capture(cmd):
	return run(cmd, capture_output=True)

def stream_lines(pipe):
	"""Yield clean lines from a binary pipe, splitting on both \\n and \\r.
    apt and dpkg emit carriage-return progress (padded overwrite lines)
    that would otherwise get embedded in our output and mangle the
    terminal -- the cause of run-together, space-padded lines."""
	buf = b""
	while True:
		chunk = pipe.read1(4096)
		if not chunk:
			break
		buf += chunk
		*lines, buf = re.split(rb"[\r\n]", buf)
		for l in lines:
			s = l.decode(errors="replace").rstrip()
			if s:
				yield s
	tail = buf.decode(errors="replace").strip()
	if tail:
		yield tail

# Lines that explain a failure. dpkg reports the actual cause -- a failing
# maintainer script, an unpack conflict -- on its own "dpkg: ..." lines, none
# of which look like apt's E:/W: output.
_FAILURE_RE = re.compile(r"^(E:|W:|dpkg:|dpkg-\w+:|Errors were encountered)"
                         r"|error processing|returned an error code")

def stream_apt(proc, handler, keep=400):
	"""Relay an apt/dpkg run, translating what we recognise and remembering
    what we don't, so a failure can still be explained.

    `handler(line)` returns True when it has dealt with a line. Portage-style
    output means suppressing most of apt's chatter, but a run that fails has
    to show why -- swallowing dpkg's reason left "emerge failed; see output
    above" pointing at nothing at all. Anything that looks like a failure is
    printed as it arrives; the rest is buffered and dumped only if the run
    actually fails. Returns the exit status."""
	buffered = []
	in_error = False
	for line in stream_lines(proc.stdout):
		if handler(line):
			in_error = False
			continue
		# dpkg continues an error onto indented lines, and that continuation
		# carries the actual message ("... subprocess returned error exit
		# status 1"). Keep it with the error it belongs to.
		if _FAILURE_RE.search(line) or (in_error and line[:1].isspace()):
			print(line)
			in_error = True
			continue
		in_error = False
		buffered.append(line)
		if len(buffered) > keep:
			del buffered[0]
	try:
		proc.stdout.close()          # we read it to EOF; don't leak the pipe
	except OSError:
		pass
	rc = proc.wait()
	if rc != 0 and buffered:
		print()
		ewarn(f"apt output leading up to the failure (last {len(buffered)} "
		      f"lines):")
		for line in buffered:
			print("  " + line)
	return rc

# ---------------------------------------------------------------------------
# Debian version comparison (policy 5.6.12), pure Python
# ---------------------------------------------------------------------------

def _order(ch):
	if ch == "~": return -1
	if ch.isdigit(): return 0
	if ch.isalpha(): return ord(ch)
	return ord(ch) + 256

def _verrevcmp(a, b):
	i = j = 0
	while i < len(a) or j < len(b):
		while ((i < len(a) and not a[i].isdigit()) or
		       (j < len(b) and not b[j].isdigit())):
			ac = _order(a[i]) if i < len(a) else 0
			bc = _order(b[j]) if j < len(b) else 0
			if ac != bc:
				return ac - bc
			i += 1; j += 1
		while i < len(a) and a[i] == "0": i += 1
		while j < len(b) and b[j] == "0": j += 1
		first_diff = 0
		while (i < len(a) and a[i].isdigit() and
		       j < len(b) and b[j].isdigit()):
			if not first_diff:
				first_diff = ord(a[i]) - ord(b[j])
			i += 1; j += 1
		if i < len(a) and a[i].isdigit(): return 1
		if j < len(b) and b[j].isdigit(): return -1
		if first_diff: return first_diff
	return 0

def vercmp(v1, v2):
	def split(v):
		epoch, _, rest = v.partition(":")
		# A colon that is not an epoch separator (a malformed version, or a
		# stray ":arch" that escaped a parser) must not crash the comparison:
		# int() on it would raise, and vercmp is reached from every code path.
		if not rest or not epoch.isdigit():
			epoch, rest = "0", v
		upstream, _, revision = rest.rpartition("-")
		if not upstream:
			upstream, revision = rest, ""
		return int(epoch), upstream, revision
	e1, u1, r1 = split(v1)
	e2, u2, r2 = split(v2)
	if e1 != e2: return e1 - e2
	rc = _verrevcmp(u1, u2)
	return rc if rc else _verrevcmp(r1, r2)

_OPS = {"<<": lambda r: r < 0, "<=": lambda r: r <= 0, "=": lambda r: r == 0,
        ">=": lambda r: r >= 0, ">>": lambda r: r > 0,
        "<":  lambda r: r <= 0, ">":  lambda r: r >= 0}

def meets(version, op, want):
	return _OPS[op](vercmp(version, want))

def _dep_ok(alt, inst, chosen, iprov, provides_of):
	"""Is a single dependency alternative (name, op, ver) already satisfied
    by an installed or already-chosen package (or a Provides of one)?
    `provides_of` is a callable: name -> [(provider, version|None), ...]."""
	name, op, ver = alt
	if name in chosen:
		return op is None or meets(chosen[name]["Version"], op, ver)
	if name in inst:
		if op is None or meets(inst[name]["Version"], op, ver):
			return True
	if op is None:
		if name in iprov:
			return True
		if any(p in chosen for p, _ in provides_of(name)):
			return True
	else:
		for _, pv in iprov.get(name, []):
			if pv and meets(pv, op, ver):
				return True
	return False

class _NduNoSolution(Exception):
	"""Every branch of the --no-dep-upgrade search was exhausted."""

class _NduBudget(Exception):
	"""The search hit its step budget without deciding either way."""

class NduIncomplete(RuntimeError):
	"""The search gave up on its budget rather than proving anything. A
    RuntimeError so existing handlers still report it, but distinguishable
    so the caller can decide to try harder."""

# Steps one pass may take before giving up. --backtrack multiplies it for the
# exhaustive retry; 0 disables the retry entirely.
STEP_BUDGET = 200000
BACKTRACK = 10                    # Portage's default, and its spelling

def _with_arg(allow, movers):
	"""The --with argument to suggest in a wall message.

    It has to carry the packages already permitted as well as the new mover:
    lockstep stacks (Mesa, Qt) wall one package at a time, and a suggestion
    naming only the latest one drops the earlier grants and bounces the user
    straight back to the previous wall."""
	return ",".join(sorted(set(allow or ()) | {m["name"] for m in movers}))

def _wall_from_merges(merges, allow, why=None):
	"""Raise NduWall if a merge list moves an installed package that is not in
    `allow`. `why` maps a package to whatever pulled it in, where known.

    The solver applies this to its own plan, and the apt backend applies it
    again to apt's simulation of that plan -- pinning the packages we chose
    does not stop apt from upgrading installed ones we never mentioned."""
	allow = allow or set()
	why = why or {}
	ups = sorted({n for n, nv, old, *_ in merges
	              if old is not None and vercmp(nv, old) > 0
	              and n not in allow})
	if not ups:
		return
	movers = []
	for n in ups:
		row = next(m for m in merges if m[0] == n)
		movers.append({
		    "name": n, "installed": row[2], "wanted": row[1],
		    "why": why.get(n, "dependency"),
		    "same_upstream": same_upstream(row[2], row[1]),
		    "session_critical": is_session_critical(n),
		})
	lines = ["--no-dep-upgrade: cannot install without moving an "
	         "already-installed package:"]
	lines += _format_movers(movers)
	lines.append("")
	lines.append(f"    to allow: {BOLD('--with ' + _with_arg(allow, movers))}")
	raise NduWall(movers, "\n".join(lines))

def _tag(exc, saw_alternatives):
	"""Mark a failure with whether an exhaustive retry could differ."""
	exc.had_alternatives = saw_alternatives
	return exc

def ndu_search(index, inst, iprov, worklist, atoms, update, allow=None,
               backtrack=None):
	"""Solve, and if that fails, solve again trying harder.

    The cheap pass takes the first alternative of every `a | b` dependency,
    which is what apt and dpkg do and what almost every graph wants. Only
    when it reports a wall or runs out of budget is it worth branching on
    those alternatives too -- so the common case never pays for a search it
    did not need, and a wall is no longer reported until the exhaustive pass
    has agreed with it.

    If the second pass also fails, the *first* failure is what gets raised:
    it names the blocker the user is most likely to act on."""
	backtrack = BACKTRACK if backtrack is None else backtrack
	try:
		return ndu_solve(index, inst, iprov, worklist, atoms, update, allow)
	except (NduWall, NduIncomplete) as first:
		if backtrack <= 0:
			raise
		if not getattr(first, "had_alternatives", True):
			# Nothing in the closure offered a choice of alternative, so the
			# thorough pass would explore exactly the same graph. Re-running
			# it would only double the time before reporting the same wall.
			raise
		einfo("no first-choice resolution; retrying with an exhaustive "
		      "search over dependency alternatives...")
		try:
			return ndu_solve(index, inst, iprov, worklist, atoms, update,
			                 allow, thorough=True,
			                 budget=STEP_BUDGET * backtrack)
		except (NduWall, NduIncomplete):
			raise first from None

def ndu_solve(index, inst, iprov, worklist, atoms, update, allow=None,
              thorough=False, budget=None):
	"""Shared --no-dep-upgrade closure solver, used by both backends.

    `index` abstracts the package source with three methods:
      index.all_versions(name) -> [stanza,...] newest-first (may be lazy)
      index.has(name)          -> bool, name is a real package
      index.provides_of(name)  -> [(provider, version|None), ...]

    Rule: an installed dependency that satisfies its constraints is kept at
    exactly its installed version (never version-searched). A not-installed
    dependency takes the newest version whose subtree upgrades nothing
    installed, stepping back to older versions as conflicts are found. An
    installed package that cannot satisfy a constraint is a genuine wall.

    The search backtracks properly: exhausting one package's versions resumes
    the previous decision at its next candidate, so a graph that only resolves
    with an older version of an *earlier* dependency is found rather than
    reported as a wall. Alternatives within one dependency (`a | b`) are still
    taken first-match, not branched on. The search is bounded by a step
    budget; hitting it raises RuntimeError rather than claiming a wall,
    because giving up early is not proof that none exists.

    `allow` is a set of installed package names the caller has permitted to
    move; these are treated as not-installed for the no-upgrade check, so
    their dependents may pull them up.

    Returns (plan, merges). Raises NduWall (carrying the structured list of
    packages that would have to move) when no combination avoids upgrading
    an installed package outside `allow`."""
	allow = allow or set()
	# a permitted package is treated as absent from the installed set for
	# the purpose of the no-upgrade checks, but its installed version is
	# still remembered for reporting the eventual move
	inst_v = {n: st["Version"] for n, st in inst.items()}
	eff_inst = {n: st for n, st in inst.items() if n not in allow}

	forced = {}          # package -> whatever put a constraint on it (blame)
	wall = None          # best blocker seen, reported if the search runs dry
	saw_alternatives = False   # did any `a | b` offer a real choice?
	dead_end = None      # name that could not be resolved at all

	def satisfies(ver, cons):
		return all(meets(ver, op, v) for op, v in cons if op)

	def candidates(name, cons):
		"""Versions `name` may take, best first.

        An installed package is pinned: it is kept at exactly its installed
        version or it is a wall. Only not-installed packages are ever
        version-searched -- that is the whole rule of --no-dep-upgrade.

        The pin is a synthetic stanza with no Depends, so a pinned package
        contributes nothing further to the closure. That is deliberate: it is
        installed, so its dependencies are already satisfied on the system,
        and walking them would make @world re-derive the whole installed tree.
        It also means a constraint can only ever reach an installed package
        from a not-installed dependent -- which forces_installed_upgrade()
        catches first, leaving the satisfies() test below as a backstop."""
		iv = eff_inst.get(name, {}).get("Version")
		if iv is not None:
			if satisfies(iv, cons):
				return [{"Package": name, "Version": iv, "_installed": True}]
			return []
		return [s for s in index.all_versions(name)
		        if satisfies(s["Version"], cons)]

	def forces_installed_upgrade(st, chosen):
		for field in ("Pre-Depends", "Depends"):
			for alts in parse_depends(st.get(field, "")):
				if any(_dep_ok(a, eff_inst, chosen, iprov, index.provides_of)
				       for a in alts):
					continue
				dn, op, dv = alts[0]
				if op and dn in eff_inst \
				   and not meets(eff_inst[dn]["Version"], op, dv):
					return (dn, op, dv)
		return None

	def note_wall(name, iv, why, cons):
		"""Remember a blocker. The search may still find a way around it, so
        this only decides what to report if every branch fails."""
		nonlocal wall
		wall = (name, iv, why, list(cons))

	def make_wall(primary_name, primary_iv, why, cons):
		"""Assemble the structured mover list for a wall. The primary is the
        package that couldn't be kept; there may be more if `allow` lets some
        through. We report the primary plus its forcing constraint."""
		wanted = None
		for op, v in cons or []:
			if op in ("=", ">=", ">>", ">"):
				wanted = v
		movers = [{
		    "name": primary_name,
		    "installed": primary_iv,
		    "wanted": wanted or "(newer)",
		    "why": why,
		    "same_upstream": bool(wanted and primary_iv not in ("?", None)
		                          and same_upstream(primary_iv, wanted)),
		    "session_critical": is_session_critical(primary_name),
		}]
		msg_lines = ["--no-dep-upgrade: cannot install without moving an "
		             "already-installed package:"]
		msg_lines += _format_movers(movers)
		movable = _with_arg(allow, movers)
		msg_lines.append("")
		msg_lines.append(f"    to allow just this: {BOLD('--with ' + movable)} "
		                 f"(or answer the prompt under -a)")
		return NduWall(movers, "\n".join(msg_lines))

	def resolve_alt(dn):
		"""An alternative's real package name, substituting a provider when
        nothing ships under that name. None when it cannot be satisfied.

        Asking index.has() here would never fire: has() is true for a virtual
        name *because* something provides it, so the name would go on the
        stack as if it were real and then fail to resolve -- reported as an
        installed package that must move, which --with can never release
        because it is not installed at all."""
		if index.all_versions(dn):
			return dn
		prov = index.provides_of(dn)
		return prov[0][0] if prov else None

	def apply_target(real, op, dv, why, chosen, cons, pending):
		"""Record one dependency choice into `cons`/`pending`, which the
        caller must already own. Returns False when it contradicts something
        already chosen -- which kills this branch, not the whole search.

        Mutates rather than copying: a closure has thousands of dependency
        clauses, and copying both structures for each of them is the whole
        cost of the pass."""
		if op:
			prev = cons.get(real, ())
			if (op, dv) not in prev:
				cons[real] = prev + ((op, dv),)
				forced.setdefault(real, why)
				if real in chosen and not satisfies(chosen[real]["Version"],
				                                    cons[real]):
					if real in eff_inst:
						note_wall(real, eff_inst[real]["Version"], why,
						          cons[real])
					return False
		if real not in chosen and real not in pending:
			pending.append(real)
		return True

	def extend(name, st, chosen, cons, pending):
		"""Queue `st`'s dependencies. Returns the new (cons, pending), or
        None if the branch is already dead."""
		nonlocal saw_alternatives
		cons = dict(cons)
		pending = list(pending)
		for field in ("Pre-Depends", "Depends"):
			for alts in parse_depends(st.get(field, "")):
				if any(_dep_ok(a, eff_inst, chosen, iprov, index.provides_of)
				       for a in alts):
					continue
				# Resolve every alternative, not just the first. It costs a
				# little in the cheap pass, but it is what makes the
				# escalation decision precise: `a | b` where both resolve to
				# the same package is not a choice, and treating it as one
				# triggers an exhaustive retry that cannot find anything.
				targets = []
				for (dn, op, dv) in alts:
					real = resolve_alt(dn)
					if real is not None and (real, op, dv) not in targets:
						targets.append((real, op, dv))
				if not targets:
					raise RuntimeError(f'cannot satisfy "{alts[0][0]}" '
					                   f'(required by {name})')
				if len(targets) > 1:
					saw_alternatives = True
				if thorough and len(targets) > 1:
					# Which of `a | b` to use becomes a decision of its own,
					# so the search can come back and try the other one. The
					# cheap pass just takes the first, like apt and dpkg do.
					item = ("|", tuple(targets), name)
					if item not in pending:
						pending.append(item)
					continue
				if not apply_target(*targets[0], name, chosen, cons,
				                    pending):
					return None
		return cons, pending

	# Backtracking search. Each decision keeps the state that preceded it, so
	# exhausting one package's versions resumes the previous decision at its
	# next candidate. The old solver committed to a choice permanently and
	# only stepped the package it was currently looking at, so a graph
	# solvable solely by an older version of an *earlier* dependency was
	# reported as a wall that did not exist.
	steps = 0
	limit = STEP_BUDGET if budget is None else budget

	def advance(frame):
		"""Move a decision on to its next workable candidate, returning the
        state that follows, or None once its candidates are spent.

        Two kinds of decision: which version a package takes, and -- in
        thorough mode -- which alternative of an `a | b` dependency to use."""
		nonlocal steps
		name = frame["name"]
		while frame["i"] < len(frame["cands"]):
			cand = frame["cands"][frame["i"]]
			frame["i"] += 1
			steps += 1
			if steps > limit:
				raise _NduBudget()
			if frame["kind"] == "clause":
				cons = dict(frame["cons"])
				pending = list(frame["pending"])
				if not apply_target(*cand, name, frame["chosen"], cons,
				                    pending):
					continue
				return frame["chosen"], cons, pending
			st = cand
			chosen = dict(frame["chosen"])
			if "_installed" not in st and name not in eff_inst:
				clash = forces_installed_upgrade(st, chosen)
				if clash is not None:
					cn, cop, cv = clash
					forced.setdefault(cn, name)
					if cn in eff_inst:
						note_wall(cn, eff_inst[cn]["Version"], name,
						          tuple(frame["cons"].get(cn, ()))
						          + ((cop, cv),))
					continue
			chosen[name] = st
			ext = extend(name, st, chosen, frame["cons"], frame["pending"])
			if ext is None:
				continue
			return chosen, ext[0], ext[1]
		return None

	chosen, constraints = {}, {}
	pending = list(dict.fromkeys(worklist))
	trail = []
	try:
		while True:
			# skip anything that needs no decision of its own
			while pending:
				head = pending[0]
				if isinstance(head, tuple):
					# a deferred `a | b`: settled if some alternative is
					# already chosen and satisfies its constraint
					if any(r in chosen
					       and (o is None
					            or satisfies(chosen[r]["Version"], ((o, v),)))
					       for r, o, v in head[1]):
						pending = pending[1:]
						continue
					break
				if not index.has(head):
					if head in atoms:
						raise RuntimeError(
						    f'there are no packages to satisfy "{head}"')
					pending = pending[1:]
				elif head in chosen:
					pending = pending[1:]
				else:
					break
			if not pending:
				break
			head = pending[0]
			if isinstance(head, tuple):
				_, targets, why = head
				frame = {"kind": "clause", "name": why, "i": 0,
				         "cands": list(targets), "chosen": chosen,
				         "cons": constraints, "pending": pending[1:]}
			else:
				name = head
				cons = constraints.get(name, ())
				frame = {"kind": "version", "name": name, "i": 0,
				         "cands": candidates(name, cons), "chosen": chosen,
				         "cons": constraints, "pending": pending[1:]}
				if not frame["cands"]:
					dead_end = name
					iv = eff_inst.get(name, {}).get("Version")
					note_wall(name, iv if iv is not None else "?",
					          forced.get(name), cons)
			nxt = advance(frame)
			while nxt is None:
				if not trail:
					raise _NduNoSolution()
				frame = trail.pop()
				nxt = advance(frame)
			trail.append(frame)
			chosen, constraints, pending = nxt
	except _NduNoSolution:
		if wall is None:
			raise _tag(RuntimeError(
			    f'cannot satisfy "{dead_end}"' if dead_end else
			    "--no-dep-upgrade: no resolution found"),
			           saw_alternatives) from None
		raise _tag(make_wall(*wall), saw_alternatives) from None
	except _NduBudget:
		raise _tag(NduIncomplete(
		    f"--no-dep-upgrade: search did not converge within "
		    f"{limit:,} steps. This is a limit of the solver, not proof "
		    f"that no resolution exists -- raise it with --backtrack=N, "
		    f"narrow the targets, or run without --no-dep-upgrade."
		), saw_alternatives) from None

	plan, merges = [], []
	ordered = list(dict.fromkeys(
	    list(worklist) + [n for n in chosen if n not in worklist]))
	for name in ordered:
		st = chosen.get(name)
		if st is None:
			continue
		old = inst.get(name, {}).get("Version")
		if old and vercmp(st["Version"], old) == 0:
			if not (name in atoms and not update):
				continue
		plan.append(st)
		merges.append((name, st["Version"], old,
		               int(st.get("Size", 0)), "ebuild", ""))

	# a package outside the allow-set still had to move: report as a wall
	try:
		_wall_from_merges(merges, allow, forced)
	except NduWall as w:
		raise _tag(w, saw_alternatives) from None
	return plan, merges


class _DpkgIndex:
	"""ndu_solve index backed by the dpkg backend's in-memory tree."""
	def __init__(self, backend):
		self.b = backend
	def all_versions(self, name):
		v = self.b.versions.get(name)
		if v is not None:
			return v
		st = self.b.pkgs.get(name)
		return [st] if st else []
	def has(self, name):
		return name in self.b.pkgs or name in self.b.versions
	def provides_of(self, name):
		return self.b.provides.get(name, [])


def upstream_version(ver):
	"""Upstream part of a Debian version: strip epoch and Debian revision.
    25.0.7-2+deb13u1 -> 25.0.7 ; 2:9.1-1ubuntu7.18 -> 9.1"""
	v = ver.split(":", 1)[-1]          # drop epoch
	return v.rsplit("-", 1)[0]         # drop Debian revision

def same_upstream(v1, v2):
	"""True if two versions share an upstream and differ only in the Debian
    revision / binNMU / stable-update suffix -- i.e. a rebuild, not a real
    version change."""
	return (upstream_version(v1) == upstream_version(v2)
	        and vercmp(v1, v2) != 0)

# --- session-critical detection ---------------------------------------------
#
# A package is "session-critical" if rebuilding it could restart the running
# display server / compositor / desktop and take your GUI apps with it. A
# same-upstream bump here is the dangerous kind: it looks like a harmless
# rebuild, and no reboot is involved, so an exclude-reboot filter would not
# help either.
#
# Rather than trust a hand-maintained list, we derive the set from the live
# system: find the processes that ARE the graphical session, see which
# binaries and shared libraries they are running, and map those files back to
# packages. That set is exactly "code the session is currently running",
# per-machine and self-updating. On a headless box no session is found, so
# nothing is critical.
#
# The static set below sits underneath that as a floor, not as an either/or
# fallback. The live scan cannot see leaders we may not read (a hardened
# compositor is root-only) and cannot see code the session dlopen()s later,
# so on a running session both sets apply.

_SESSION_CRITICAL_EXACT = {
    "libgl1", "libglx-mesa0", "libglapi-mesa", "libgbm1", "libegl1",
    "libegl-mesa0", "libgles2", "libvulkan1", "libdrm2", "libgallium",
    "mesa-libgallium", "mesa-va-drivers", "mesa-vdpau-drivers",
    "libwayland-client0", "libwayland-server0", "libwayland-egl1",
    "xserver-xorg-core", "xwayland", "libx11-6", "libxcb1",
    "gdm3", "sddm", "lightdm", "systemd-logind",
}
_SESSION_CRITICAL_PREFIX = ("libgl1-mesa", "libgl1-amber", "xserver-xorg-video-",
                            "libmutter-", "libgtk-", "libqt5gui", "libqt6gui")

# Process names (comm) that identify a graphical session leader.
#
# These are matched against /proc/PID/comm, which the kernel caps at
# TASK_COMM_LEN-1 = **15 characters**. A binary with a longer name appears
# truncated, so the truncated spelling is what has to be listed -- and an
# entry longer than 15 characters can never match anything, silently. Both
# rules are asserted by TestSessionLeaderComms; measured, not assumed:
#
#     gdm-session-worker  (18) -> "gdm-session-wor"
#     sddm-greeter-qt6    (16) -> "sddm-greeter-qt"
#
# That second one was a live gap. SDDM 0.21 renamed its greeter binary to
# sddm-greeter-qt6, which is one character over the limit, so on Debian
# trixie the greeter went undetected -- the entry below said "sddm-greeter",
# which was correct only for SDDM 0.20 and earlier. Both spellings are kept:
# the old name is still what older stable releases run.
_SESSION_LEADER_COMMS = {
	# X server / Xwayland
    "Xorg", "X", "Xwayland",
	# Wayland compositors / shells
    "gnome-shell", "kwin_wayland", "kwin_x11", "plasmashell", "sway",
    "weston", "mutter", "wayfire", "labwc", "hyprland", "river", "cosmic-comp",
    "cinnamon", "xfwm4", "marco", "muffin", "compiz", "openbox", "i3",
	# display managers and their greeters
    "gdm", "gdm3", "gdm-session-wor", "sddm",
    "sddm-greeter",                     # SDDM <= 0.20
    "sddm-greeter-qt",                  # SDDM >= 0.21, truncated from -qt6
    "lightdm", "lightdm-gtk-gre", "slick-greeter", "ly", "greetd",
}

def _proc_comm(pid):
	try:
		with open(f"/proc/{pid}/comm") as f:
			return f.read().strip()
	except OSError:
		return None

def _proc_exe(pid):
	"""Path to the binary a process is running, if we may read it."""
	try:
		path = os.readlink(f"/proc/{pid}/exe")
	except OSError:
		return None
	if path.endswith(" (deleted)"):      # binary replaced under a running proc
		path = path[:-len(" (deleted)")]
	return path if path.startswith("/") else None

def _proc_mapped_code(pid, comm=None):
	"""File-backed *code* a process currently has mapped: its own executable
    plus every shared library. Data mappings (fonts, icon caches, locale
    archives) carry no execute bit and are skipped -- upgrading those cannot
    change the code the session is running.

    A hardened leader (dumpable=0, e.g. a setcap'd compositor) hides both
    /proc/PID/exe and /proc/PID/maps from anyone but root, so a non-root
    `emerge -p` would learn nothing about it. Falling back to resolving its
    comm on PATH still names the binary, which is the important one."""
	files = set()
	exe = _proc_exe(pid)
	if not exe and comm:
		exe = shutil.which(comm)             # truncated comms simply miss
	if exe:
		files.add(exe)
	try:
		with open(f"/proc/{pid}/maps") as f:
			for line in f:
				# split off exactly the five leading fields: the pathname is
				# the rest of the line and may itself contain spaces, so
				# splitting on every space truncates such a mapping to its
				# first word and loses the library entirely
				parts = line.split(None, 5)
				if len(parts) == 6:
					perms, path = parts[1], parts[5].rstrip("\n")
					if path.endswith(" (deleted)"):
						path = path[:-len(" (deleted)")]
					if path.startswith("/") and ("x" in perms or ".so" in path):
						files.add(path)
	except OSError:
		pass
	return files

def _find_session_leaders():
	"""(pid, comm) for processes whose comm marks them a graphical-session
    leader. Returns None if /proc could not be scanned at all -- that is "we
    cannot tell", a different answer from [] ("scanned, nothing running")."""
	try:
		pids = [d for d in os.listdir("/proc") if d.isdigit()]
	except OSError:
		return None
	found = ((p, _proc_comm(p)) for p in pids)
	return [(p, c) for p, c in found if c in _SESSION_LEADER_COMMS]

_session_critical_cache = None   # None = not computed; set() = computed empty
_session_blind = False           # couldn't tell what (if anything) is running

def compute_session_critical_packages():
	"""Packages whose code the running graphical session has loaded. Cached
    for the process. An empty set means either no session is running or we
    were not allowed to look; `_session_blind` tells the two apart."""
	global _session_critical_cache, _session_blind
	if _session_critical_cache is not None:
		return _session_critical_cache

	leaders = _find_session_leaders()
	if leaders is None:                      # /proc not readable at all
		_session_blind = True
		_session_critical_cache = set()
		return _session_critical_cache
	if not leaders:
		_session_critical_cache = set()      # headless / no GUI session
		return _session_critical_cache

	files = set()
	for pid, comm in leaders:
		files |= _proc_mapped_code(pid, comm)
	if not files:
		# A session is up but every leader was opaque: hardened processes run
		# with dumpable=0, so /proc/PID/{maps,exe} is root-only and a non-root
		# `emerge -p` sees nothing. Blind, not headless.
		_session_blind = True
		_session_critical_cache = set()
		return _session_critical_cache

	# one batched dpkg-query -S for all paths (per-call is ~8x slower)
	pkgs = set()
	r = capture(["dpkg-query", "-S"] + sorted(files))
	for line in r.stdout.splitlines():
		# format: "pkg1, pkg2: /path"  (diversions can list several)
		head, _, _path = line.partition(": ")
		if head:
			for p in head.split(", "):
				p = p.split(":")[0].strip()   # drop :arch qualifier
				if p:
					pkgs.add(p)
	_session_critical_cache = pkgs
	return pkgs

def session_impact(name, oldver, newver):
	"""How much moving a package actually disturbs the running session.

    None      -- not code the session is using.
    "rebuild" -- same upstream, only the Debian revision/binNMU/security
                 suffix moved.
    "upgrade" -- a real upstream version change.

    The distinction is not cosmetic. dpkg replaces the files, but a running
    process keeps the inodes it already mapped, so a rebuild does not restart
    the display server and does not close anything -- Mesa 25.0.7-2 ->
    25.0.7-2+deb13u1 is a point-release rebuild, not a session teardown.
    What a rebuild does leave is a window until the next login where anything
    the session loads *later* (DRI drivers, VA-API, Vulkan ICDs are all
    dlopen'd on demand) is the new build inside a process still holding the
    old one. Worth saying, not worth planning downtime around."""
	if not is_session_critical(name):
		return None
	if oldver and newver and same_upstream(oldver, newver):
		return "rebuild"
	return "upgrade"

def is_session_critical(name):
	"""True if moving `name` could disturb the running session.

    The live set is the ground truth for what the session actually loaded, but
    it is a floor, not a ceiling: leaders we were not allowed to read
    contribute nothing, and code the session dlopen()s later is not mapped yet.
    So the static recogniser sits underneath it whenever a session exists.
    With no session running there is nothing to disturb and nothing is
    critical -- unless we could not tell, where we stay conservative."""
	live = compute_session_critical_packages()
	if name in live:
		return True
	if not live and not _session_blind:
		return False                         # genuinely headless
	return (name in _SESSION_CRITICAL_EXACT
	        or name.startswith(_SESSION_CRITICAL_PREFIX))


class NduWall(Exception):
	"""Raised when --no-dep-upgrade cannot avoid moving installed packages.
    Carries the movers so the caller can offer an escape hatch (--with /
    interactive) instead of only printing a dead end.

    movers: list of dicts {name, installed, wanted, why, same_upstream,
                           session_critical}
    """
	def __init__(self, movers, message):
		super().__init__(message)
		self.movers = movers


def _format_movers(movers):
	"""Human-readable, per-package block for a wall, with same-upstream and
    session-critical annotations."""
	lines = []
	for m in movers:
		note = ""
		if m["same_upstream"]:
			up = upstream_version(m["wanted"])
			note = f"  (same upstream {up}; Debian revision bump)"
		line = f"    {BOLD(m['name'])} {m['installed']} -> {m['wanted']}{note}"
		lines.append(line)
		if m["why"]:
			lines.append(f"        pulled in by {m['why']}")
		if m["session_critical"]:
			if m["same_upstream"]:
				lines.append(f"        {BLUE('- session in use')}: same "
				             f"upstream, so this is a rebuild -- the session "
				             f"keeps running; drivers")
				lines.append(f"          it loads later use the new build "
				             f"until you log out")
			else:
				lines.append(f"        {YELLOW('! session-critical')}: this "
				             f"may restart X/Wayland and close running apps")
	return lines

# ---------------------------------------------------------------------------
# Control-file parsing
# ---------------------------------------------------------------------------

def parse_stanzas(text):
	stanza, key = {}, None
	for line in text.splitlines():
		if not line.strip():
			if stanza:
				yield stanza
			stanza, key = {}, None
		elif line[0] in " \t":
			if key:
				stanza[key] += "\n" + line.strip()
		else:
			key, _, val = line.partition(":")
			stanza[key] = val.strip()
	if stanza:
		yield stanza

DEP_RE = re.compile(r"^\s*([a-z0-9][a-z0-9+.-]*)\s*(?::\s*\S+)?"
                    r"(?:\s*\(\s*(<<|<=|=|>=|>>|<|>)\s*([^)]+?)\s*\))?"
                    r"(?:\s*\[[^\]]*\])?\s*$")

_DEP_WARNED = set()

def parse_depends(field):
	clauses = []
	for clause in field.split(","):
		alts = []
		for alt in clause.split("|"):
			m = DEP_RE.match(alt)
			if m:
				alts.append((m.group(1), m.group(2), m.group(3)))
		if alts:
			clauses.append(alts)
		elif clause.strip():
			# Dropping the clause makes an unparseable dependency look
			# *satisfied*, which is the one direction a resolver must never
			# fail in. Refusing to run is worse -- one odd field would break
			# every operation -- but it cannot pass unremarked either.
			key = clause.strip()
			if key not in _DEP_WARNED:
				_DEP_WARNED.add(key)
				eerror(f'cannot parse dependency "{key}" -- ignoring it; '
				       f"the resolution that follows may be wrong.")
	return clauses

# ---------------------------------------------------------------------------
# Shared display layer
# ---------------------------------------------------------------------------

def print_merge_list(merges, verbose):
	"""merges: [(name, newver, oldver|None, size_bytes, kind, use)]
    kind: 'ebuild' (source build / normal merge) | 'binary' (dep .deb)"""
	n_new = n_up = n_down = n_re = 0
	dl = 0
	rebuilt, upgraded = [], []
	for name, newver, oldver, size, kind, use in merges:
		if oldver is None:
			flag, col = "N", GREEN; n_new += 1
		else:
			r = vercmp(newver, oldver)
			if r > 0:   flag, col = "U", BCYAN; n_up += 1
			elif r < 0: flag, col = "D", BLUE;  n_down += 1
			else:       flag, col = "R", YELLOW; n_re += 1
		label = GREEN("ebuild") if kind == "ebuild" else BLUE("binary")
		line = (f"[{label}  {col(flag)}    ] "
		        f"{BGREEN(name + '-' + newver)}")
		if flag in "UD":
			line += f" [{BLUE(oldver)}]"
		# flag upgrades/downgrades of packages the running session is using,
		# distinguishing a rebuild from a real version change
		if flag in "UD":
			impact = session_impact(name, oldver, newver)
			if impact == "rebuild":
				line += f" {BLUE('(session rebuild)')}"
				rebuilt.append(name)
			elif impact == "upgrade":
				line += f" {YELLOW('(session)')}"
				upgraded.append(name)
		if use:
			line += f' USE="{RED(use)}"'
		if verbose and size:
			dl += size
			line += f" {size / 1024:,.1f} KiB"
		print(line)
	print()
	s = f"Total: {len(merges)} packages ({n_up} upgrades, {n_new} new"
	if n_re:   s += f", {n_re} reinstalls"
	if n_down: s += f", {n_down} downgrades"
	s += ")"
	if verbose and dl:
		s += f", Size of downloads: {dl / 2**20:,.1f} MiB"
	print(s)
	def _names(ns):
		return ", ".join(ns[:8]) + (" ..." if len(ns) > 8 else "")

	if upgraded:
		print()
		ewarn(f"{len(upgraded)} package(s) in use by your graphical session "
		      f"would be upgraded: {_names(upgraded)}")
		ewarn("Applying these may restart X/Wayland and close running apps.")
	if rebuilt:
		print()
		einfo(f"{len(rebuilt)} package(s) in use by your graphical session "
		      f"would be rebuilt: {_names(rebuilt)}")
		einfo("Same upstream version, so your session keeps running. Open apps "
		      "stay on the old build until you log out.")

def print_unmerge_list(removals, requested=None):
	"""removals: [(name, version)] -- everything that will actually go.

    `requested` names what the user asked for; anything else in `removals`
    only goes because it depends on one of those, and has to be shown as
    such. Listing just the requested names and then handing the whole
    cascade to `apt-get -y remove` means confirming a removal you were
    never shown."""
	asked = set(requested) if requested is not None else {p for p, _ in removals}
	selected = [(p, v) for p, v in removals if p in asked]
	collateral = [(p, v) for p, v in removals if p not in asked]

	print(f"\n{BGREEN(' These are the packages that would be unmerged:')}\n")
	for pkg, ver in selected:
		print(f" {BGREEN(pkg)}")
		print(f"    {GREEN('selected:')} {ver}")
		print(f"   {GREEN('protected:')} none")
		print(f"     {GREEN('omitted:')} none\n")
	print("All selected packages: " +
	      " ".join(f"{p}-{v}" for p, v in selected) + "\n")
	if collateral:
		# built outside the f-string: a replacement field may not span lines
		# before Python 3.12, and this script has to run on older ones
		heading = "These depend on the above and would also be removed:"
		print(f" {RED(heading)}\n")
		line = "    "
		for pkg, _ in collateral:
			if len(line) + len(pkg) > 76:
				print(line); line = "    "
			line += pkg + " "
		if line.strip():
			print(line)
		print()
		ewarn(f"{len(collateral)} additional package(s) would be removed as "
		      f"a consequence, {len(removals)} in total.")
	ewarn("'Selected' packages are slated for removal.")
	ewarn("'Protected' and 'omitted' packages will not be removed.\n")

def ask_continue(verb="merge"):
	try:
		ans = input(f"\nWould you like to {verb} these packages? "
		            f"[{GREEN('Yes')}/{RED('No')}] ")
	except (EOFError, KeyboardInterrupt):
		print(); return False
	return ans.strip().lower() in ("", "y", "yes")

def ask_yesno(prompt):
	"""Yes/No prompt defaulting to No (used for risky confirmations)."""
	try:
		ans = input(f"{prompt} [{RED('yes')}/{GREEN('No')}] ")
	except (EOFError, KeyboardInterrupt):
		print(); return False
	return ans.strip().lower() in ("y", "yes")

def calc_deps_start():
	print("Calculating dependencies... ", end="", flush=True)

# Warnings raised while the progress line is open, printed once it closes.
_deferred_warnings = []

def ewarn_later(msg):
	"""Queue a warning until `Calculating dependencies... ` is finished.

    That line is deliberately left open with no newline, so anything printed
    during the resolve lands in the middle of it. The sync path avoids the
    same defect by verifying the archive signature *before* opening its
    progress line; a resolve cannot be reordered that way, because what is
    worth warning about is only discovered inside it."""
	_deferred_warnings.append(msg)

def calc_deps_done(ok=True):
	print(GREEN("done!") if ok else RED("failed!"))
	while _deferred_warnings:
		ewarn(_deferred_warnings.pop(0))

# ---------------------------------------------------------------------------
# Shared: installed state from dpkg's status file (no subprocesses)
# ---------------------------------------------------------------------------

# name -> the architectures it is installed for, when there is more than one.
# A property of the status file rather than of any one call, and
# installed_state() is called from a dozen places, so it is recorded here as
# that parse happens rather than being worked out again by each caller.
MULTIARCH_INSTANCES = {}


def installed_state():
	"""{name: stanza} of installed packages, parsed from dpkg status.

    Keyed by name alone, which a multiarch system makes ambiguous: after
    `dpkg --add-architecture i386`, `libfoo:amd64` and `libfoo:i386` are two
    installed packages sharing one name, and the later stanza silently wins
    here. Any name that collided is recorded in MULTIARCH_INSTANCES so that
    the callers who cannot cope say so, instead of working from half a
    view."""
	inst = {}
	arches = {}
	with open(STATUS, errors="replace") as f:
		for st in parse_stanzas(f.read()):
			status = st.get("Status", "")
			if "installed" in status and "not-installed" not in status:
				name = st["Package"]
				arches.setdefault(name, []).append(st.get("Architecture", "?"))
				inst[name] = st
	MULTIARCH_INSTANCES.clear()
	MULTIARCH_INSTANCES.update(
	    {n: sorted(set(a)) for n, a in arches.items() if len(set(a)) > 1})
	return inst

def is_protected(st):
	return (st.get("Essential", "no") == "yes"
	        or st.get("Priority") == "required")

def system_set(inst):
	"""Debian's equivalent of Gentoo's @system: Essential + required."""
	return {n for n, st in inst.items() if is_protected(st)}

# ---------------------------------------------------------------------------
# Sources: /etc/apt/sources.list + deb822 *.sources (http, https, file)
# ---------------------------------------------------------------------------

def read_sources():
	"""Return [(base_url, suite, [components], signed_by)]. A suite ending in
    '/' is a flat repository. `signed_by` is the keyring path (or inline key
    material) the entry names, or None to fall back to the system trust
    store."""
	entries = []
	def one_line(line):
		# read the options block before stripping it: signed-by names the only
		# key that may sign this entry, and honouring it is the difference
		# between apt's trust model and "anything in the keyring will do"
		signed_by = None
		m = re.search(r"signed-by=([^\s\]]+)", " ".join(re.findall(r"\[(.*?)\]",
		                                                          line)))
		if m:
			signed_by = m.group(1)
		line = re.sub(r"\[.*?\]", "", line)
		parts = line.split()
		if len(parts) >= 3 and parts[0] == "deb":
			entries.append((parts[1].rstrip("/"), parts[2],
			                parts[3:] or ["main"], signed_by))
	files = ["/etc/apt/sources.list"]
	d = "/etc/apt/sources.list.d"
	if os.path.isdir(d):
		files += [os.path.join(d, f) for f in sorted(os.listdir(d))]
	for path in files:
		if not os.path.isfile(path):
			continue
		with open(path, errors="replace") as f:
			text = f.read()
		if path.endswith(".sources"):
			for st in parse_stanzas(text):
				# sources.list(5): "it is usually easier to add the field
				# Enabled: no to the stanza to disable the entry". Syncing
				# from a repository the admin switched off is not a small
				# oversight -- it is the one they explicitly asked us not
				# to touch.
				if st.get("Enabled", "yes").strip().lower() in ("no", "false"):
					continue
				if "deb" not in st.get("Types", ""):
					continue
				signed_by = st.get("Signed-By", "").strip() or None
				for uri in st.get("URIs", "").split():
					for suite in st.get("Suites", "").split():
						entries.append((uri.rstrip("/"), suite,
						                st.get("Components", "main").split(),
						                signed_by))
		elif path.endswith((".list", "sources.list")):
			for line in text.splitlines():
				line = line.strip()
				if line and not line.startswith("#"):
					one_line(line)
	return entries

# A package index is large -- Debian's amd64 main is tens of megabytes
# uncompressed -- but it is not unbounded, and on this backend nothing else
# decides how much memory a repository may ask for. Generous enough that no
# real archive comes close; small enough that an embedded box survives a
# hostile one.
MAX_INDEX_BYTES = 512 * 1024 * 1024


def fetch(url, timeout=60, limit=None):
	"""http(s):// and file:// both via urllib; bare paths become file://.

    `limit` caps what will be read. A server decides how many bytes it
    sends, so a plain read() lets a repository -- or anything sitting on the
    http:// connection to one -- decide how much memory this process uses."""
	if url.startswith("/"):
		url = "file://" + url
	req = urllib.request.Request(url, headers={"User-Agent": "emerge/1.0"})
	with urllib.request.urlopen(req, timeout=timeout) as r:
		if limit is None:
			return r.read()
		# One byte past the limit, so that hitting it exactly is not an error
		# while exceeding it is detectable without reading the rest.
		data = r.read(limit + 1)
		if len(data) > limit:
			raise RuntimeError(f"{url}: larger than {limit} bytes; refusing "
			                   f"to read the rest")
		return data


def write_atomic(path, data, prepare=None, suffix=".tmp"):
	"""Write bytes so a reader sees either the old file or the whole new one.

    The index was the one thing written straight over itself. Config files go
    through `_write` and the world file through `_write_world`, both
    temp-then-rename with an fsync and both carrying a comment about why --
    and `sync()` opened the index for writing and started filling it. So a
    Ctrl-C during a long download, a full disk, or a crash left a *truncated*
    Packages file behind.

    That is the shape that does not announce itself: a short index parses
    perfectly and simply has fewer packages in it, so the resolver answers
    from part of the archive and says "there are no packages to satisfy" for
    things that plainly exist. Measured: interrupting a 500-package index a
    third of the way through leaves 168 packages and no error anywhere.

    `--sync` is exactly the operation people interrupt, being the slow one
    that talks to the network.

    Written once and shared, because every step of it has to be right and a
    copy that has drifted looks identical from the outside: flush and fsync
    before the rename, or the rename can land while the content is still in
    the page cache; fsync the directory after, or the rename itself may not
    survive; unlink the temporary file on any failure, so a crash does not
    leave litter in `/etc` or `/var/lib`. Three copies of this existed and
    one was already missing that last part.

    `prepare` runs against the temporary file just before the rename, for
    callers that must carry mode, owner or xattrs across: `os.replace` swaps
    in a new inode, so whatever is not copied over is gone."""
	tmp = path + suffix
	try:
		with open(tmp, "wb") as f:
			f.write(data)
			f.flush()
			os.fsync(f.fileno())
		if prepare is not None:
			prepare(tmp)
		os.replace(tmp, path)
	except BaseException:
		try:
			os.unlink(tmp)
		except OSError:
			pass
		raise
	_fsync_dir(path)


def decompress_bounded(raw, ext, limit=MAX_INDEX_BYTES):
	"""Decompress an index, refusing to produce more than `limit` bytes.

    `gzip.decompress`/`lzma.decompress` produce whatever the input asks for,
    and a compressor is very good at asking. Measured: 61 KB of .xz expands
    to 400 MB, a ratio of 6,859 -- so a mirror serving nine megabytes can
    demand sixty gigabytes, and this is the backend written for boxes that
    do not have it.

    Decompressing in bounded steps costs nothing on a real index and turns
    the attack into an error message."""
	if ext == "":
		if len(raw) > limit:
			raise RuntimeError(f"index is larger than {limit} bytes")
		return raw
	if ext == ".gz":
		obj = zlib.decompressobj(16 + zlib.MAX_WBITS)
	elif lzma is not None:
		obj = lzma.LZMADecompressor()
	else:
		raise RuntimeError("no lzma support in this Python")

	out = bytearray()
	step = 4 * 1024 * 1024
	data = raw
	while True:
		# zlib and lzma each raise their own error type for corrupt input.
		# One exception type out of here means a caller has one thing to
		# catch and the message always says which file went wrong.
		try:
			chunk = obj.decompress(data, step)
		except DECOMPRESS_ERRORS as e:
			raise RuntimeError(f"index is corrupt: {e}") from e
		out += chunk
		if len(out) > limit:
			raise RuntimeError(
			    f"index expands to more than {limit} bytes; refusing it. "
			    f"A {len(raw)} byte file that unpacks past this is not an "
			    f"archive index.")
		# zlib hands leftover input back; lzma keeps it and wants b"".
		data = getattr(obj, "unconsumed_tail", b"")
		if obj.eof:
			break
		if not chunk and not data:
			# No progress and not at the end: truncated or corrupt.
			raise RuntimeError("index is truncated or corrupt")
	return bytes(out)

# ---------------------------------------------------------------------------
# Repository signature verification (dpkg backend)
# ---------------------------------------------------------------------------
#
# The dpkg backend already checks every .deb against a SHA256 taken from the
# Packages index. That chain is only worth as much as the index it starts
# from, and nothing vouched for the index. Verifying the archive's signature
# over Release -- and the index against the hashes inside it -- anchors it.
#
# gpgv is the whole dependency: it is a single verify-only binary from
# gnupg, not apt, so an apt-less box can still have it.

TRUSTED_DIR = "/etc/apt/trusted.gpg.d"
TRUSTED_LEGACY = "/etc/apt/trusted.gpg"

_ARMOUR_RE = re.compile(r"-----BEGIN PGP PUBLIC KEY BLOCK-----(.*?)"
                        r"-----END PGP PUBLIC KEY BLOCK-----", re.S)

def dearmor(data):
	"""ASCII-armoured public key block -> raw OpenPGP packets.

    gpgv reads binary keyrings only, and Debian ships most of its archive
    keys as armoured .asc, so we unwrap them here. Shelling out to gpg(1) for
    this would pull in exactly the dependency an apt-less box lacks. Data
    that is already binary passes through untouched."""
	if b"-----BEGIN PGP" not in data[:4096]:
		return data
	out = b""
	for m in _ARMOUR_RE.finditer(data.decode("utf-8", "replace")):
		body = m.group(1)
		# armour headers (Version:, Comment:) run to the first blank line
		for sep in ("\n\n", "\r\n\r\n"):
			if sep in body:
				body = body.split(sep, 1)[1]
				break
		# '=' starts the CRC24 trailer, which is not part of the packets
		b64 = "".join(l for l in body.splitlines()
		              if l.strip() and not l.startswith("="))
		try:
			out += base64.b64decode(b64)
		except Exception:
			continue
	return out

def clearsigned_payload(text):
	"""The signed message out of a clearsigned document (an InRelease).

    Only the region gpgv actually covered is returned: everything from the
    end of the armour headers up to the signature block, dash-unescaped per
    RFC 4880. Getting this wrong can only produce a hash mismatch, never a
    silent pass, because the hashes it yields are what we then enforce."""
	start = text.find("-----BEGIN PGP SIGNED MESSAGE-----")
	if start < 0:
		return None
	rest = text[start:]
	for sep in ("\n\n", "\r\n\r\n"):
		if sep in rest:
			rest = rest.split(sep, 1)[1]
			break
	else:
		return None
	end = rest.find("-----BEGIN PGP SIGNATURE-----")
	if end < 0:
		return None
	lines = rest[:end].split("\n")
	# the newline in front of the signature armour terminates the last line,
	# it is not an extra empty one
	if lines and lines[-1] == "":
		lines.pop()
	return "".join(l[2:] + "\n" if l.startswith("- ") else l + "\n"
	               for l in lines)

def release_hashes(text):
	"""{path: sha256} from a Release file's SHA256 section."""
	hashes = {}
	in_sha = False
	for line in text.splitlines():
		if not line[:1].isspace():
			in_sha = line.startswith("SHA256:")
			continue
		if in_sha:
			parts = line.split()
			if len(parts) >= 3:
				hashes[parts[2]] = parts[0]
	return hashes


class Verifier:
	"""Checks repository metadata signatures with gpgv.

    A failed check is fatal. Being *unable* to check is not: an embedded box
    may have no gpgv, and a USB-stick repo has no Release at all. Those warn
    and continue, so turning this on cannot break a setup that worked before
    -- it only ever adds a guarantee where one is available."""

	def __init__(self, enabled=True):
		self.wanted = enabled
		self.enabled = enabled and bool(shutil.which("gpgv"))
		if enabled and not self.enabled:
			ewarn("gpgv not found: repository signatures will NOT be checked "
			      "(install gpgv, or pass --no-verify to silence this).")
		self._rings = {}          # signed_by -> keyring path or None
		self._releases = {}       # (base, suite) -> verified text or None
		self._tmp = []
		self._warned = set()
		self.checked = 0

	@property
	def had_warnings(self):
		return bool(self._warned)

	def _warn_once(self, key, msg):
		if key not in self._warned:
			self._warned.add(key)
			ewarn(msg)

	def _tmpfile(self, data, suffix):
		fd, path = tempfile.mkstemp(prefix="emerge-verify-", suffix=suffix)
		with os.fdopen(fd, "wb") as f:
			f.write(data)
		self._tmp.append(path)
		return path

	def close(self):
		for path in self._tmp:
			try:
				os.unlink(path)
			except OSError:
				pass
		self._tmp = []

	def keyring(self, signed_by=None):
		"""Path to a binary keyring holding the keys trusted for a source.

        A Debian InRelease carries several signatures and gpgv fails the file
        if it cannot check even one of them, so every candidate key has to be
        handed over in a single keyring rather than one file per call."""
		if signed_by in self._rings:
			return self._rings[signed_by]
		blob = b""
		if signed_by and "BEGIN PGP" in signed_by:
			blob = dearmor(signed_by.encode())          # inline key material
		else:
			if signed_by:
				files = signed_by.replace(",", " ").split()
			else:
				files = []
				if os.path.isdir(TRUSTED_DIR):
					files += [os.path.join(TRUSTED_DIR, f)
					          for f in sorted(os.listdir(TRUSTED_DIR))]
				if os.path.isfile(TRUSTED_LEGACY):
					files.append(TRUSTED_LEGACY)
			for path in files:
				try:
					with open(path, "rb") as f:
						blob += dearmor(f.read())
				except OSError:
					self._warn_once(f"key:{path}",
					                f"cannot read keyring {path}")
		path = self._tmpfile(blob, ".gpg") if blob else None
		self._rings[signed_by] = path
		return path

	def _gpgv(self, ring, sig_path, data_path=None):
		cmd = ["gpgv", "--keyring", ring, sig_path]
		if data_path:
			cmd.append(data_path)
		return subprocess.run(cmd, stdout=subprocess.DEVNULL,
		                      stderr=subprocess.PIPE).returncode == 0

	def release(self, base, suite, signed_by=None):
		"""Fetch and verify the Release for one (base, suite), returning its
        verified text -- or None if it could not be checked at all."""
		key = (base, suite)
		if key in self._releases:
			return self._releases[key]
		self._releases[key] = None
		if not self.enabled:
			return None
		ring = self.keyring(signed_by)
		if not ring:
			self._warn_once("nokeys",
			                f"no usable keys in {TRUSTED_DIR}: repository "
			                f"signatures will NOT be checked.")
			return None

		stem = (f"{base}/{suite}" if suite.endswith("/")
		        else f"{base}/dists/{suite}/").replace("/./", "/")
		text = None
		# InRelease (inline signature) first, then detached Release+Release.gpg
		try:
			raw = fetch(stem + "InRelease")
			if self._gpgv(ring, self._tmpfile(raw, ".InRelease")):
				text = clearsigned_payload(raw.decode("utf-8", "replace"))
			else:
				raise RuntimeError(
				    f"{base} {suite}: InRelease signature verification "
				    f"FAILED (bad signature, or signed by an untrusted key)")
		except (urllib.error.URLError, OSError, ValueError):
			pass
		if text is None:
			try:
				rel = fetch(stem + "Release")
				sig = fetch(stem + "Release.gpg")
				rel_path = self._tmpfile(rel, ".Release")
				if not self._gpgv(ring, self._tmpfile(sig, ".gpg"), rel_path):
					raise RuntimeError(
					    f"{base} {suite}: Release signature verification "
					    f"FAILED (bad signature, or signed by an untrusted "
					    f"key)")
				text = rel.decode("utf-8", "replace")
			except (urllib.error.URLError, OSError, ValueError):
				pass
		if text is None:
			self._warn_once(f"norel:{base} {suite}",
			                f"{base} {suite}: no verifiable InRelease or "
			                f"Release; its index is NOT signature-checked.")
		self._releases[key] = text
		return text

	def check_index(self, base, suite, signed_by, relpath, raw):
		"""Check a downloaded index against the signed Release. Raises on a
        mismatch; returns True when the index was genuinely verified."""
		text = self.release(base, suite, signed_by)
		if text is None:
			return False
		want = release_hashes(text).get(relpath)
		if want is None:
			self._warn_once(f"nohash:{base} {suite} {relpath}",
			                f"{base} {suite}: {relpath} is not listed in "
			                f"Release; NOT hash-checked.")
			return False
		got = hashlib.sha256(raw).hexdigest()
		if got != want:
			raise RuntimeError(
			    f"{base} {suite}: SHA256 mismatch for {relpath}\n"
			    f"  expected {want}\n  got      {got}\n"
			    f"The index does not match the signed Release. Refusing to "
			    f"use it.")
		self.checked += 1
		return True


# ---------------------------------------------------------------------------
# dpkg backend
# ---------------------------------------------------------------------------

class DpkgBackend:
	name = "dpkg"

	def __init__(self, pretend=False):
		self.pkgs = {}        # name -> best index stanza
		self.provides = {}    # virtual -> [(provider, version|None)]
		self.versions = None  # name -> [stanza,...] (built lazily on demand)
		self._plan = []       # resolver output stanzas, kept for merge()
		self._seeded = False
		self._pretend = pretend
		self._world_seed = set()
		self._seed_world()

	# -- world file ---------------------------------------------------------

	def _seed_world(self):
		"""Populate the world file when the backend is constructed.

        A first run has no world file, and everything already installed is
        what the user chose, so that is the seed.

        The timing is load-bearing and was briefly wrong: deferring this to
        the first _read_world() looked tidier, but merge() reads the world
        file *after* dpkg has run, so the seed then captured the packages
        the merge had just installed -- pulling every dependency of the very
        first install into @world permanently. Invisible unless you are
        root, because the guard below returns early otherwise, so it passed
        on a workstation and failed in a debian:trixie container.

        Construction is the right moment: it happens before anything is
        installed. `emerge -V` does not construct a backend at all -- see
        backend_name() -- so a version query still creates nothing."""
		if self._seeded:
			return
		self._seeded = True
		if os.path.exists(WORLD) or os.geteuid() != 0:
			return
		inst = installed_state()
		if self._pretend:
			# A pretend run must leave nothing behind, and this is the only
			# place the dpkg backend writes without being asked to -- so
			# `emerge -p bash` on a fresh root box created a 92-entry world
			# file, on a run that then failed for want of a package tree.
			# Exactly the shape of the `emerge -V` bug that moved this out of
			# pick_backend(), reached through a different door.
			#
			# Keep the seed in memory rather than skipping it: @selected is
			# what it is whether or not the file exists yet, and a --pretend
			# that showed a different set from the real run would be a worse
			# answer than the file.
			self._world_seed = set(inst)
			return
		os.makedirs(LIB_DIR, exist_ok=True)
		with open(WORLD, "w") as f:
			f.write("\n".join(sorted(inst)) + "\n")
		einfo(f"Seeded world file with {len(inst)} currently installed packages.")

	def _read_world(self):
		if not os.path.exists(WORLD):
			# Empty unless a pretend run seeded in memory above, in which
			# case this is the set the real run would have written.
			return set(self._world_seed)
		with open(WORLD) as f:
			return {l.strip() for l in f if l.strip()}

	def _write_world(self, names):
		# Atomic, so a crash mid-write can never truncate the world file:
		# only pins are transient, and this record should survive. It had
		# its own copy of that sequence and was the one missing the cleanup
		# on failure, so an interrupted write left a world.tmp behind.
		os.makedirs(LIB_DIR, exist_ok=True)
		write_atomic(WORLD, ("\n".join(sorted(names)) + "\n").encode())

	# -- sync ---------------------------------------------------------------

	@staticmethod
	def _tree_file(base, suite, comp):
		safe = re.sub(r"[^A-Za-z0-9._-]", "_", f"{base}_{suite}_{comp}")
		return os.path.join(TREE_DIR, safe + "_Packages")

	@staticmethod
	def _scan_deb_dir(directory, base):
		"""Generate a Packages index from a bare directory of .deb files."""
		out = []
		for fn in sorted(os.listdir(directory)):
			if not fn.endswith(".deb"):
				continue
			path = os.path.join(directory, fn)
			r = capture(["dpkg-deb", "-f", path])
			if r.returncode != 0:
				ewarn(f"skipping unreadable {fn}")
				continue
			h = hashlib.sha256()
			with open(path, "rb") as f:
				for chunk in iter(lambda: f.read(1 << 20), b""):
					h.update(chunk)
			fields = r.stdout.rstrip("\n")
			fields += (f"\nFilename: {fn}"
			           f"\nSize: {os.path.getsize(path)}"
			           f"\nSHA256: {h.hexdigest()}")
			out.append(fields)
		return ("\n\n".join(out) + "\n").encode()

	def sync(self, verify=True):
		need_root()
		os.makedirs(TREE_DIR, exist_ok=True)
		a = capture(["dpkg", "--print-architecture"]).stdout.strip()
		sources = read_sources()
		if not sources:
			eerror("No sources found in /etc/apt/sources.list[.d]. "
			       "On apt-less systems, create one (plain `deb` lines work).")
			sys.exit(1)
		einfo(f"Syncing {len(sources)} repository entries...")
		verifier = Verifier(verify)
		ok = signed = 0
		for base, suite, comps, signed_by in sources:
			flat = suite.endswith("/")
			for comp in comps:
				if flat:
					stem = f"{base}/{suite}Packages".replace("/./", "/")
					relbase = "Packages"
				else:
					stem = f"{base}/dists/{suite}/{comp}/binary-{a}/Packages"
					relbase = f"{comp}/binary-{a}/Packages"
				# Verify the Release before opening the progress line, so a
				# warning or a failure report does not land in the middle of
				# it. Cached per (base, suite), so this costs one fetch.
				try:
					verifier.release(base, suite, signed_by)
				except RuntimeError as e:
					verifier.close()
					eblock(str(e))
					sys.exit(1)
				print(f"{ARROW} Fetching {BLUE(f'{base} {suite}/{comp}')} ...",
				      end=" ", flush=True)
				data = None
				used_ext = ""
				this_signed = False
				exts = [".gz", ""]
				if lzma:
					exts.insert(0, ".xz")
				for ext in exts:
					try:
						raw = fetch(stem + ext, limit=MAX_INDEX_BYTES)
					except Exception:
						continue
					# Check the hash BEFORE unpacking. Release records the
					# hash of the file as transferred, so the check is on
					# `raw` whichever order these run in -- but decompressing
					# first let a mirror spend this process's memory on bytes
					# nothing had vouched for yet, and a compressor is very
					# good at asking for memory.
					try:
						signed_now = verifier.check_index(
						    base, suite, signed_by, relbase + ext, raw)
					except RuntimeError as e:
						print(RED("FAILED"))
						verifier.close()
						eblock(str(e))
						sys.exit(1)
					try:
						data = decompress_bounded(raw, ext)
					except Exception:
						data = None
						continue
					used_ext, this_signed = ext, signed_now
					signed += this_signed
					break
				if data is None and flat and base.startswith("file://"):
					directory = base[len("file://"):]
					if os.path.isdir(directory):
						data = self._scan_deb_dir(directory, base)
						print(GREEN("indexed") +
						      f" ({data.count(b'Package:')} debs scanned)")
				if data is None:
					print(RED("failed"))
					continue
				else:
					if not (flat and base.startswith("file://")
					        and not os.path.exists(stem)):
						mark = f" [{GREEN('gpg ✓')}]" if this_signed else ""
						print(GREEN("done") +
						      f" ({len(data) / 2**20:,.1f} MiB){mark}")
				write_atomic(self._tree_file(base, suite, comp), data)
				ok += 1
				if flat:
					break
		verifier.close()
		print(f"\n{ARROW} Sync completed: {ok} indexes in {TREE_DIR}")
		if verifier.enabled:
			if signed == ok:
				einfo(f"All {ok} indexes verified against signed Release files.")
			else:
				tail = " (see warnings above)" if verifier.had_warnings else ""
				ewarn(f"{signed} of {ok} indexes were signature-verified; "
				      f"the rest could not be checked{tail}.")
		einfo("In post-sync... " + GREEN("done!"))

	# -- index --------------------------------------------------------------

	def _load_index(self, all_versions=False):
		if self.pkgs and (self.versions is not None or not all_versions):
			return
		if not os.path.isdir(TREE_DIR) or not os.listdir(TREE_DIR):
			eerror("No package tree found. Run `emerge --sync` first.")
			sys.exit(1)
		allvers = {} if all_versions else None
		if not self.pkgs:
			for fn in os.listdir(TREE_DIR):
				with open(os.path.join(TREE_DIR, fn), errors="replace") as f:
					for st in parse_stanzas(f.read()):
						name = st.get("Package")
						if not name or "Version" not in st:
							continue
						if allvers is not None:
							allvers.setdefault(name, []).append(st)
						cur = self.pkgs.get(name)
						if cur is None or vercmp(st["Version"],
						                         cur["Version"]) > 0:
							self.pkgs[name] = st
			for name, st in self.pkgs.items():
				for clauses in parse_depends(st.get("Provides", "")):
					for (v, _, ver) in clauses:
						self.provides.setdefault(v, []).append((name, ver))
		elif all_versions:
			# index already loaded newest-only; re-read just to collect
			# every version (only reached when --no-dep-upgrade runs)
			for fn in os.listdir(TREE_DIR):
				with open(os.path.join(TREE_DIR, fn), errors="replace") as f:
					for st in parse_stanzas(f.read()):
						name = st.get("Package")
						if name and "Version" in st:
							allvers.setdefault(name, []).append(st)

		if all_versions:
			# newest-first per package, for the downgrade search. Most
			# packages have one version -- keep those, sort only the rest.
			self.versions = {}
			_key = functools.cmp_to_key(vercmp)
			for name, sts in allvers.items():
				if len(sts) == 1:
					self.versions[name] = sts
					continue
				sts.sort(key=lambda s: _key(s["Version"]), reverse=True)
				seen, ordered = set(), []
				for st in sts:
					if st["Version"] not in seen:
						seen.add(st["Version"]); ordered.append(st)
				self.versions[name] = ordered

	@staticmethod
	def _inst_provides(inst):
		m = {}
		for name, st in inst.items():
			for clauses in parse_depends(st.get("Provides", "")):
				for (v, _, pver) in clauses:
					m.setdefault(v, []).append((name, pver))
		return m

	# -- resolver -----------------------------------------------------------

	# Set once per process, the first time a stale world file is noticed, so
	# that a run touching @world several times says it once. A class
	# attribute rather than anything in __init__: constructing a backend
	# must not do work, which this project has been bitten by before.
	_warned_stale_world = False

	_warned_multiarch = False

	def _warn_multiarch(self):
		"""Say when the system holds packages this backend cannot represent.

        `installed_state()` is keyed by name, so on a multiarch system one
        instance of each shared name is simply dropped -- and the resolver
        then plans against a view of the machine that is missing packages.
        The right fix is to key by name:architecture throughout, which
        reaches the resolver, the world file, depclean and the index (which
        is fetched for the native architecture only). That is a real piece of
        work rather than a patch, and the backend exists for embedded boxes
        that are single-architecture, so for now this says so plainly instead
        of pretending otherwise."""
		if DpkgBackend._warned_multiarch or not MULTIARCH_INSTANCES:
			return
		DpkgBackend._warned_multiarch = True
		names = sorted(MULTIARCH_INSTANCES)
		ewarn_later(f"{len(names)} package(s) are installed for more than "
		            f"one architecture, and this backend keys packages by "
		            f"name alone:")
		ewarn_later("  " + " ".join(names[:8])
		            + (" ..." if len(names) > 8 else ""))
		ewarn_later("Only one instance of each is visible to it. Use the apt "
		            "backend on a multiarch system.")

	def _selected(self, inst):
		"""The world file's installed members, saying so when some are not.

        A world entry that is not installed is dropped from @selected, and
        it used to be dropped in silence. That left the two ways of asking
        for the same package answering differently: naming it outright says
        `there are no packages to satisfy "foo"` and exits 1, while reaching
        it through @world printed an ordinary plan and exited 0, with
        nothing anywhere to say an entry had been ignored.

        Warn rather than fail. On Debian a package that has left the archive
        between releases is ordinary, and refusing to compute @world until
        the file was tidied would block the very upgrade that resolves it."""
		world = self._read_world()
		installed = world & set(inst)
		missing = sorted(world - installed)
		if missing and not DpkgBackend._warned_stale_world:
			DpkgBackend._warned_stale_world = True
			ewarn_later(f"{len(missing)} package(s) in {WORLD} are not "
			            f"installed, and are being skipped:")
			ewarn_later("  " + " ".join(missing))
		return installed

	def expand_sets(self, targets):
		"""Split targets into explicit atoms and set-derived member names."""
		atoms, members = [], set()
		inst = installed_state()
		for t in targets:
			if t == "@world":
				members |= self._selected(inst) | system_set(inst)
			elif t == "@selected":
				members |= self._selected(inst)
			elif t == "@system":
				members |= system_set(inst)
			else:
				atoms.append(t)
		return atoms, sorted(members)

	@staticmethod
	def _dep_closure(inst, seed):
		"""Closure of seed over installed Depends/Pre-Depends/Recommends."""
		iprov = DpkgBackend._inst_provides(inst)
		keep, stack = set(seed), list(seed)
		while stack:
			st = inst.get(stack.pop())
			if not st:
				continue
			for field in ("Depends", "Pre-Depends", "Recommends"):
				for alts in parse_depends(st.get(field, "")):
					for (dn, _, _) in alts:
						hits = [dn] if dn in inst else \
						       [p for p, _ in iprov.get(dn, [])]
						for h in hits:
							if h not in keep:
								keep.add(h); stack.append(h)
		return keep

	def resolve(self, targets, update=False, deep=False,
	            no_dep_upgrade=False, allow=None):
		self._load_index(all_versions=no_dep_upgrade)
		inst = installed_state()
		self._warn_multiarch()
		iprov = self._inst_provides(inst)

		atoms, set_members = self.expand_sets(targets)
		self._atoms = list(atoms)          # only these get world-file entries
		worklist = atoms + set_members
		if deep and update and set_members:
			# --deep widens the update scope from the set members to the
			# full dependency closure of the sets (Gentoo -uD @world)
			worklist = atoms + sorted(self._dep_closure(inst, set(set_members)))

		if no_dep_upgrade:
			return self._resolve_no_upgrade(worklist, atoms, inst, iprov,
			                                update, allow)
		return self._resolve_inner(worklist, atoms, inst, iprov, update,
		                           pins={})

	def _resolve_inner(self, worklist, atoms, inst, iprov, update, pins):
		"""Core resolver. `pins` maps name -> chosen stanza, overriding the
        default 'newest' pick (used by the no-upgrade search to force older
        target versions)."""
		selected, order = {}, []
		pending, reinstalls = set(), set()

		def candidate(name):
			return pins.get(name) or self.pkgs.get(name)

		def dep_satisfied(name, op, ver):
			if name in selected:
				return op is None or meets(selected[name]["Version"], op, ver)
			if name in inst and name not in pending:
				if op is None or meets(inst[name]["Version"], op, ver):
					return True
			if op is None:
				if name in iprov:
					return True
				if any(p in selected for p, _ in self.provides.get(name, [])):
					return True
			else:
				cands = iprov.get(name, []) + \
				        [(p, pv) for p, pv in self.provides.get(name, [])
				         if p in selected]
				for _, pv in cands:
					if pv and meets(pv, op, ver):
						return True
			return False

		def select(name, why):
			st = candidate(name)
			if st is None:
				provs = self.provides.get(name, [])
				if provs:
					return select(provs[0][0], why)
				raise RuntimeError(f'there are no packages to satisfy "{name}" '
				                   f"(required by {why})")
			if name in selected:
				return
			selected[name] = st
			order.append(name)
			for field in ("Pre-Depends", "Depends"):
				for alts in parse_depends(st.get(field, "")):
					if any(dep_satisfied(*a) for a in alts):
						continue
					for (dn, op, dv) in alts:
						cand = candidate(dn)
						if cand and (op is None
						             or meets(cand["Version"], op, dv)):
							select(dn, name)
							break
						if op and dn in self.provides:
							hit = next((p for p, pv in self.provides[dn]
							            if pv and meets(pv, op, dv)), None)
							if hit:
								select(hit, name)
								break
					else:
						pretty = " | ".join(a[0] for a in alts)
						raise RuntimeError(f'cannot satisfy dependency '
						                   f'"{pretty}" of {name}')

		for t in worklist:
			st = candidate(t)
			if st is None and t not in self.provides:
				if t in atoms:
					raise RuntimeError(f'there are no packages to satisfy "{t}"')
				continue                    # set member no longer in repos
			iv = inst.get(t, {}).get("Version")
			if iv and st is not None:
				r = vercmp(st["Version"], iv)
				if r < 0 and t not in pins:
					continue                # repo older than installed
				if r == 0:
					if update:              # -u: skip up-to-date
						continue
					reinstalls.add(t)       # no -u: re-merge, like Gentoo
				pending.add(t)
			select(t, "argument")

		plan, merges = [], []
		for name in order:
			st = selected[name]
			old = inst.get(name, {}).get("Version")
			if old and vercmp(st["Version"], old) == 0 \
			   and name not in reinstalls:
				continue
			plan.append(st)
			merges.append((name, st["Version"], old,
			               int(st.get("Size", 0)), "ebuild", ""))

		for st in plan:
			for field in ("Conflicts", "Breaks"):
				for alts in parse_depends(st.get(field, "")):
					for (cn, op, cv) in alts:
						vv = None
						if cn in selected and cn != st["Package"]:
							vv = selected[cn]["Version"]
						elif cn in inst and cn not in selected:
							vv = inst[cn]["Version"]
						if vv and (op is None or meets(vv, op, cv)):
							raise RuntimeError(
							    f"{st['Package']} {field.lower()} with {cn} "
							    f"-- blocked; unmerge it first")
		self._plan = plan
		return merges

	def _resolve_no_upgrade(self, worklist, atoms, inst, iprov, update,
	                        allow=None):
		"""Whole-closure downgrade search via the shared solver."""
		plan, merges = ndu_search(_DpkgIndex(self), inst, iprov,
		                          worklist, atoms, update, allow)
		self._plan = plan
		return merges

	# -- fetch & install ----------------------------------------------------

	def _download(self):
		os.makedirs(DISTFILES, exist_ok=True)
		bases = [b for b, *_ in read_sources()]
		paths, total = [], len(self._plan)
		for i, st in enumerate(self._plan, 1):
			fname = os.path.basename(st["Filename"])
			dest = os.path.join(DISTFILES, fname)
			pv = f"{st['Package']}-{st['Version']}"
			if os.path.exists(dest) and self._sha256(dest) == st.get("SHA256"):
				print(f"{ARROW} Reusing distfile ({i} of {total}) {BGREEN(pv)}")
				paths.append(dest); continue
			print(f"{ARROW} Fetching ({i} of {total}) {BGREEN(pv)} ...",
			      end=" ", flush=True)
			# The index says how big the file is, so anything past that is
			# already wrong and there is no reason to hold it in memory to
			# find out. The SHA256 below is what decides correctness; this
			# only stops a mirror choosing how much memory to spend before
			# getting there. A stanza without a usable Size gets no limit,
			# which is the old behaviour.
			try:
				cap = int(st.get("Size", ""))
			except ValueError:
				cap = None
			data = None
			for base in bases:
				try:
					data = fetch(f"{base}/{st['Filename']}", limit=cap)
					break
				except Exception:
					continue
			if data is None:
				print(RED("failed"))
				raise RuntimeError(f"could not fetch {st['Filename']}")
			want = st.get("SHA256")
			if want and hashlib.sha256(data).hexdigest() != want:
				print(RED("checksum mismatch!"))
				raise RuntimeError(f"SHA256 verification failed for {fname}")
			with open(dest, "wb") as f:
				f.write(data)
			if want:
				print(GREEN("ok") + f" [{GREEN('sha256 ✓')}]")
			else:
				# Every real Packages file carries one, and so does the index
				# generated for a USB directory. Missing means the index is
				# not what we think it is, and the .deb is unverified -- say
				# so rather than printing a bare "ok" for an unchecked file.
				print(YELLOW("ok") + f" [{YELLOW('no sha256 in index')}]")
				ewarn(f"{fname} was installed without a checksum: its index "
				      f"entry has no SHA256 field.")
			paths.append(dest)
		return paths

	@staticmethod
	def _sha256(path):
		h = hashlib.sha256()
		with open(path, "rb") as f:
			for chunk in iter(lambda: f.read(1 << 20), b""):
				h.update(chunk)
		return h.hexdigest()

	def merge(self, merges, targets, opts):
		need_root()
		print()
		try:
			debs = self._download()
		except RuntimeError as e:
			print(f"{RED('!!!')} {BOLD(str(e))}"); sys.exit(1)
		if opts["fetchonly"]:
			einfo("Fetch complete."); return
		conf = load_conf()
		print()
		total = len(self._plan)

		def abort(msg):
			"""Bail out, but not before recording the state of whatever did
            get installed and announcing any config files dpkg parked."""
			archive_settled(conf, [st["Package"] for st in self._plan])
			print(f"{RED('!!!')} {msg}")
			pending_notice(conf)
			sys.exit(1)

		# deps were appended after their dependents, so reversing the plan
		# gives install order: dependencies first, targets last
		seq = list(reversed(list(zip(self._plan, debs))))
		staged = False

		def configure_all(what):
			r = capture(["dpkg", "--force-confold", "--force-confdef",
			             "--configure", "-a"])
			if r.returncode != 0:
				print(r.stderr, file=sys.stderr)
				abort(what)

		for i, (st, deb) in enumerate(seq, 1):
			pv = f"{st['Package']}-{st['Version']}"
			print(f"{ARROW} Emerging ({i} of {total}) {BGREEN(pv)}")
			# dpkg refuses to unpack a package whose Pre-Depends is merely
			# unpacked -- it must be *configured* first -- so deferring every
			# configure to the end fails outright the moment a plan contains
			# a new package that pre-depends on another new one. Configuring
			# what is already staged first is apt's "immediate configuration"
			# pass under a different name, and Pre-Depends is rare enough
			# that this costs nothing on an ordinary merge.
			if staged and st.get("Pre-Depends"):
				configure_all(f"configure phase failed before {pv}")
			r = capture(["dpkg", "--force-confold", "--force-confdef",
			             "--unpack", "--auto-deconfigure", deb])
			if r.returncode != 0:
				print(r.stderr, file=sys.stderr)
				abort(f"unpack failed for {pv}")
			staged = True
		configure_all("configure phase failed")
		for i, (st, _deb) in enumerate(seq, 1):
			pv = f"{st['Package']}-{st['Version']}"
			print(f"{ARROW} Installing ({i} of {total}) {BGREEN(pv)}")
			print(f"{ARROW} Completed ({i} of {total}) {BGREEN(pv)}")
		archive_settled(conf, [st["Package"] for st in self._plan])
		atoms = getattr(self, "_atoms", [])
		if not opts["oneshot"] and atoms:
			w = self._read_world() | set(atoms)
			self._write_world(w)
			print(f"\n{ARROW} Recording targets in \"world\" favorites file "
			      f"({WORLD})")
		print(f"{ARROW} {BGREEN('Auto-cleaning packages...')}\n")
		einfo("GNU info directory index is up-to-date.")
		pending_notice(conf)

	# -- unmerge & depclean --------------------------------------------------

	def _reverse_deps(self, inst, victims):
		rdeps = {}
		for name, st in inst.items():
			if name in victims:
				continue
			for field in ("Depends", "Pre-Depends"):
				for alts in parse_depends(st.get(field, "")):
					names = [a[0] for a in alts]
					if any(n in victims for n in names) and \
					   all(n in victims or n not in inst for n in names):
						for v in set(names) & victims:
							rdeps.setdefault(v, []).append(name)
		return rdeps

	def unmerge_candidates(self, targets, opts):
		inst = installed_state()
		self._warn_multiarch()
		removals = []
		for t in targets:
			if t not in inst:
				ewarn(f"{t} is not installed; skipping."); continue
			if t in MULTIARCH_INSTANCES:
				# dpkg refuses this itself -- "ambiguous package name 'libfoo'
				# with more than one installed instance" -- but only after the
				# plan has been shown and confirmed, and it says nothing about
				# which instance was meant. Stop here, where the names can be
				# spelled out.
				arches = MULTIARCH_INSTANCES[t]
				eerror(f"{t} is installed for {len(arches)} architectures: "
				       + ", ".join(f"{t}:{a}" for a in arches))
				eerror("This backend keys packages by name, so it cannot say "
				       "which you mean, and dpkg would refuse the removal as "
				       "ambiguous. Name the instance to dpkg directly:")
				eerror(f"    dpkg -r {t}:{arches[0]}")
				sys.exit(1)
			if is_protected(inst[t]):
				eerror(f"{t} is Essential/required; refusing to unmerge.")
				sys.exit(1)
			removals.append((t, inst[t]["Version"]))
		rdeps = self._reverse_deps(inst, {p for p, _ in removals})
		for victim, users in rdeps.items():
			ewarn(f"{victim} is required by: {', '.join(users[:6])}"
			      + (" ..." if len(users) > 6 else ""))
		if rdeps:
			# Said whether or not -a was given, because -a is where it used
			# to mislead: dpkg refuses to remove a package another installed
			# one needs, so a confirmed unmerge went on to fail with a raw
			# dpkg error. The old text read "use -a to override", and there
			# is nothing here for -a to override.
			#
			# This is a real difference between the backends rather than a
			# wording problem: `apt-get remove` takes the dependents with it,
			# so on the apt backend -a genuinely does cascade. See project.md.
			ewarn("dpkg will not remove a package another installed one "
			      "needs; unmerge the dependents in the same command.")
		if rdeps and not opts["ask"] and not opts["pretend"]:
			everything = sorted({u for us in rdeps.values() for u in us}
			                    | {p for p, _ in removals})
			eerror("Unmerging would break reverse dependencies. Unmerge "
			       "them together:")
			eerror(f"    emerge -C {' '.join(everything)}")
			# The hatch stays, because this analysis can over-report: it
			# does not consider Provides, so a dependency satisfied by a
			# virtual package looks broken here and not to dpkg.
			eerror("...or use -a to try anyway.")
			sys.exit(1)
		return removals

	def depclean_candidates(self):
		self._load_index()
		inst = installed_state()
		seed = system_set(inst) | self._selected(inst)
		keep = self._dep_closure(inst, seed)
		return [(v, inst[v]["Version"]) for v in sorted(set(inst) - keep)]

	def unmerge(self, removals):
		need_root()
		if not removals:
			return
		total = len(removals)
		for i, (pkg, ver) in enumerate(removals, 1):
			print(f"{ARROW} Unmerging ({i} of {total}) "
			      f"{RED(pkg + '-' + ver)}...")
		# One call for the whole list, not one per package. dpkg works out
		# the removal order itself; going one at a time in the order the user
		# typed dies as soon as an earlier victim is depended on by a later
		# one -- `emerge -C libfoo foo` failed on the first package.
		r = capture(["dpkg", "-r"] + [p for p, _ in removals])
		if r.returncode != 0:
			print(r.stderr, file=sys.stderr)
			print(f"{RED('!!!')} unmerge failed."); sys.exit(1)
		self._write_world(self._read_world() - {p for p, _ in removals})
		print(f"\n{ARROW} {BGREEN('Auto-cleaning packages...')}")
		einfo("GNU info directory index is up-to-date.")

	def deselect(self, names, pretend):
		"""Drop names from @selected without unmerging anything.

        The world file is the only part of @selected that is ours to edit,
        and until now nothing could edit it: `emerge -C` removes an entry,
        but only as a side effect of unmerging, and it skips a package that
        is not installed -- which is exactly the entry worth removing. A
        world file naming something the archive no longer carries could
        therefore be reported (it is, on every resolve) and not fixed,
        except with a text editor."""
		world = self._read_world()
		drop = [n for n in names if n in world]
		# Before announcing anything. Printing "Removing x" and then finding
		# out we are not root tells the user the thing happened when it did
		# not -- and stdout is block-buffered while the error is not, so the
		# two even arrive in the wrong order.
		if drop and not pretend:
			need_root()
		verb = "Would remove" if pretend else "Removing"
		for name in names:
			if name in world:
				print(f"{ARROW} {verb} {BGREEN(name)} from "
				      f'"world" favorites file...')
			else:
				ewarn(f"{name} is not in @selected; skipping.")
		if drop and not pretend:
			self._write_world(world - set(drop))
		return drop

	# -- search ---------------------------------------------------------------

	def search(self, terms, desc):
		self._load_index()
		inst = installed_state()
		for term in terms:
			rx = re.compile(term, re.I)
			hits = [st for name, st in sorted(self.pkgs.items())
			        if rx.search(name)
			        or (desc and rx.search(st.get("Description", "")))]
			print_search_header(term, len(hits))
			for st in hits:
				name = st["Package"]
				iv = inst.get(name, {}).get("Version", "[ Not Installed ]")
				print_search_hit(name, st["Version"], iv,
				                 st.get("Description", "").splitlines()[0],
				                 int(st.get("Size", 0)))

# ---------------------------------------------------------------------------
# apt backend
# ---------------------------------------------------------------------------

class _AptIndex:
	"""ndu_solve index backed by apt-cache, fetching each package's versions
    (with full Depends/Provides) lazily and caching them."""
	def __init__(self):
		self._cache = {}          # name -> [stanza,...] newest-first
		self._provides = {}       # virtual -> [(provider, ver|None)]
		self._known = {}          # name -> bool

	def _load(self, name):
		if name in self._cache:
			return self._cache[name]
		r = capture(["apt-cache", "show", name])
		stanzas = [st for st in parse_stanzas(r.stdout)
		           if st.get("Package") == name and "Version" in st]
		seen, ordered = set(), []
		for st in sorted(stanzas,
		                 key=lambda s: functools.cmp_to_key(vercmp)
		                 (s["Version"]), reverse=True):
			if st["Version"] not in seen:
				seen.add(st["Version"]); ordered.append(st)
		self._cache[name] = ordered
		for st in ordered:
			for clauses in parse_depends(st.get("Provides", "")):
				for (v, _, ver) in clauses:
					self._provides.setdefault(v, []).append((name, ver))
		return ordered

	def all_versions(self, name):
		return self._load(name)

	def has(self, name):
		if name in self._known:
			return self._known[name]
		# `in self._provides` would be wrong: provides_of() leaves an empty
		# list behind to mark a name as already probed.
		ok = bool(self._load(name)) or bool(self._provides.get(name))
		self._known[name] = ok
		return ok

	def provides_of(self, name):
		if name not in self._provides:
			# discover providers of a virtual not yet seen, via showpkg's
			# "Reverse Provides" section, then load each so we learn versions
			r = capture(["apt-cache", "showpkg", name])
			in_rev = False
			found = []
			for line in r.stdout.splitlines():
				if line.startswith("Reverse Provides:"):
					in_rev = True
					continue
				if in_rev and line.strip():
					prov = line.split()[0]
					if prov and prov != name:
						found.append(prov)
			for p in found:
				self._load(p)          # registers its Provides mapping
			# mark as probed even if nothing found, so we don't re-shell
			self._provides.setdefault(name, self._provides.get(name, []))
		return self._provides.get(name, [])


class AptBackend:
	name = "apt"

	def __init__(self):
		self._action = None    # remembered apt-get action for merge()
		self._merges = []

	def sync(self):
		need_root()
		einfo("Starting rsync with apt mirrors...")
		print(f"{ARROW} Starting retry 1 of 1 with apt-get update")
		rc = run(["apt-get", "update"]).returncode
		if rc == 0:
			print(f"\n{ARROW} Sync completed with apt repositories")
			einfo("In post-sync... " + GREEN("done!"))
		else:
			eerror("Sync failed.")
		sys.exit(rc)

	@staticmethod
	def _installed_version(pkg):
		r = capture(["dpkg-query", "-W", "-f=${Version} ${Status}", pkg])
		if r.returncode != 0:
			return None
		parts = r.stdout.strip().rsplit(" ", 3)
		if len(parts) == 4 and parts[3] == "installed":
			return parts[0]
		return None

	@staticmethod
	def _sizes(names):
		sizes = {}
		for i in range(0, len(names), 200):
			r = capture(["apt-cache", "show"] + names[i:i + 200])
			for st in parse_stanzas(r.stdout):
				p = st.get("Package")
				if p and "Size" in st and p not in sizes:
					sizes[p] = int(st["Size"])
		return sizes

	def expand_sets(self, targets):
		atoms, members, had_world = [], set(), False
		for t in targets:
			if t in ("@world", "@selected"):
				r = capture(["apt-mark", "showmanual"])
				members |= {l.strip() for l in r.stdout.splitlines()
				            if l.strip()}
				if t == "@world":
					had_world = True
					members |= system_set(installed_state())
			elif t == "@system":
				members |= system_set(installed_state())
			else:
				atoms.append(t)
		return atoms, sorted(members), had_world

	def _resolve_no_upgrade(self, atoms, members, update, allow=None):
		"""Full-closure downgrade search using the shared solver, fed by an
        apt-cache-backed index. Resolves exact version pins that avoid
        upgrading anything installed, then hands them to apt to execute.

        This replaces the earlier hold-and-retry heuristic (which pinned
        conflicting deps to their installed versions and gave up when apt
        could not satisfy the target with them frozen). The solver instead
        steps intermediate not-installed dependencies down through their own
        older versions -- exhausting real alternatives -- exactly as the
        dpkg backend does."""
		inst = installed_state()
		iprov = DpkgBackend._inst_provides(inst)
		index = _AptIndex()
		worklist = atoms + members
		plan, merges = ndu_search(index, inst, iprov, worklist, atoms,
		                          update, allow)
		# Turn the chosen stanzas into explicit apt version pins
		pins = []
		for st in plan:
			pins.append(f"{st['Package']}={st['Version']}")
		self._action = ["install"] + pins if pins else ["install"] + atoms
		self._merges = merges
		return merges

	def resolve(self, targets, update=False, deep=False,
	            no_dep_upgrade=False, allow=None):
		atoms, members, had_world = self.expand_sets(targets)
		self._atoms = list(atoms)          # only these are world candidates
		if no_dep_upgrade:
			self._resolve_no_upgrade(atoms, members, update, allow)
		elif had_world and update and deep:
			# emerge -uD @world: the full-tree upgrade apt's solver owns.
			# Atoms still have to be carried: `emerge -uD @world foo` asks
			# for foo as well, and dist-upgrade takes package arguments.
			self._action = ["dist-upgrade"] + atoms
		elif update:
			# -u: upgrade if outdated, install if missing, never reinstall
			# current versions -- exactly apt-get install's semantics
			self._action = ["install"] + atoms + members
		else:
			# no -u: re-merge like Gentoo (reinstall current versions too)
			self._action = ["install", "--reinstall"] + atoms + members
		r = capture(["apt-get", "-s", "-qq",
		             "-o", "APT::Get::Show-User-Simulation-Note=0"]
		            + self._action)
		if r.returncode != 0:
			raise RuntimeError((r.stderr or r.stdout).strip()
			                   .replace("E: ", ""))
		raw = []
		for line in r.stdout.splitlines():
			m = re.match(r"^Inst ([^\s:]+)(?::\S+)?(?: \[([^\]]+)\])? \((\S+) ", line)
			if m:
				name, old, new = m.group(1), m.group(2), m.group(3)
				if old is None:
					old = self._installed_version(name)
				raw.append((name, new, old))
		sizes = self._sizes([n for n, _, _ in raw])
		merges = [(n, new, old, sizes.get(n, 0), "ebuild", "")
		          for n, new, old in raw]
		if no_dep_upgrade:
			# The solver cleared its own plan, but this simulation is what apt
			# will really do, and pinning the packages we chose leaves it free
			# to upgrade installed ones we never named -- a lockstep stack like
			# Mesa moves as a block. Hold apt's answer to the same rule.
			_wall_from_merges(merges, allow)
		self._merges = merges
		return merges

	def merge(self, merges, targets, opts):
		need_root()
		print()
		conf = load_conf()
		if opts["fetchonly"]:
			rc = run(["apt-get", "-y", "-d"] + self._action).returncode
			if rc == 0:
				einfo("Fetch complete.")
			sys.exit(rc)
		total = len(merges)
		order = {m[0]: i + 1 for i, m in enumerate(merges)}
		vers  = {m[0]: m[1] for m in merges}
		# snapshot before the install: apt marks everything it is told to
		# install as manual, so afterwards there is no way to tell which of
		# them were already in @world beforehand
		was_manual = self._manual_set()
		proc = subprocess.Popen(
		    ["apt-get", "-y", "-q", "-o", "Dpkg::Use-Pty=0",
		     "-o", "Dpkg::Options::=--force-confold",
		     "-o", "Dpkg::Options::=--force-confdef"] + self._action,
		    stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
		    env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"})
		def translate(line):
			m = re.match(r"^(Unpacking|Setting up) ([^\s:]+)(?::\S+)? ", line)
			if m:
				verb, pkg = m.groups()
				i = order.get(pkg)
				if not i:
					return False
				pv = f"{pkg}-{vers[pkg]}"
				if verb == "Unpacking":
					print(f"{ARROW} Emerging ({i} of {total}) {BGREEN(pv)}")
				else:
					print(f"{ARROW} Installing ({i} of {total}) {BGREEN(pv)}")
					print(f"{ARROW} Completed ({i} of {total}) {BGREEN(pv)}")
				return True
			if re.match(r"^(Get:|Fetched|Removing)", line):
				print(line)
				return True
			return False

		rc = stream_apt(proc, translate)
		print()
		if rc == 0:
			self._apply_marks(was_manual, opts["oneshot"])
			print(f"{ARROW} {BGREEN('Auto-cleaning packages...')}\n")
			einfo("GNU info directory index is up-to-date.")
		# Regardless of the outcome: whatever did get installed has settled
		# conffiles that must be archived as the new ancestor, and anything
		# dpkg parked has to be announced. A partial install is exactly when
		# you need to be told there are config files waiting.
		archive_settled(conf, [m[0] for m in merges])
		pending_notice(conf)
		if rc != 0:
			print(f"{RED('!!!')} {BOLD('emerge failed; see output above.')}")
			sys.exit(rc)

	def unmerge_candidates(self, targets, opts):
		inst = installed_state()
		names = []
		for t in targets:
			if t not in inst:
				ewarn(f"{t} is not installed; skipping.")
				continue
			if is_protected(inst[t]):
				eerror(f"{t} is Essential/required; refusing to unmerge.")
				sys.exit(1)
			names.append(t)
		if not names:
			return []
		# Ask apt what removing these actually costs. `apt-get remove` takes
		# everything that depends on the target with it, and reporting only
		# the names the user typed invites them to confirm a one-line removal
		# that takes hundreds of packages -- removing libjpeg62-turbo on a
		# desktop is 868 of them, and the merge runs with -y.
		r = capture(["apt-get", "-s", "-qq", "remove"] + names)
		if r.returncode != 0:
			eerror((r.stderr or r.stdout).strip().replace("E: ", ""))
			sys.exit(1)
		removals = []
		for line in r.stdout.splitlines():
			m = re.match(r"^Remv ([^\s:]+)(?::\S+)?(?: \[([^\]]+)\])?", line)
			if m:
				removals.append((m.group(1),
				                 m.group(2)
				                 or self._installed_version(m.group(1)) or "?"))
		# Same guard the dpkg backend applies: an unmerge that takes
		# dependents with it is not something to do silently, and without -a
		# there is no confirmation step at all before apt-get -y runs.
		asked = set(names)
		extra = [p for p, _ in removals if p not in asked]
		if extra and not opts["ask"] and not opts["pretend"]:
			eerror(f"Unmerging would also remove {len(extra)} package(s) that "
			       f"depend on this. Use -p to list them, or -a to confirm.")
			sys.exit(1)
		return removals

	def depclean_candidates(self):
		r = capture(["apt-get", "-s", "-qq", "autoremove"])
		removals = []
		for line in r.stdout.splitlines():
			m = re.match(r"^Remv ([^\s:]+)(?::\S+)?(?: \[([^\]]+)\])?", line)
			if m:
				removals.append((m.group(1),
				                 m.group(2) or self._installed_version(m.group(1))
				                 or "?"))
		self._depclean = True
		return removals

	def unmerge(self, removals):
		need_root()
		cmd = (["apt-get", "-y", "-q", "-o", "Dpkg::Use-Pty=0", "autoremove"]
		       if getattr(self, "_depclean", False)
		       else ["apt-get", "-y", "-q", "-o", "Dpkg::Use-Pty=0",
		             "remove"] + [p for p, _ in removals])
		total = len(removals)
		proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
		                        stderr=subprocess.STDOUT,
		                        env={**os.environ,
		                             "DEBIAN_FRONTEND": "noninteractive"})
		seen = [0]

		def translate(line):
			m = re.match(r"^Removing ([^\s:]+)(?::\S+)? \(([^)]+)\)", line)
			if m:
				seen[0] += 1
				print(f"{ARROW} Unmerging ({seen[0]} of {total}) "
				      f"{RED(m.group(1) + '-' + m.group(2))}...")
				return True
			return False

		rc = stream_apt(proc, translate)
		if rc != 0:
			print(f"{RED('!!!')} unmerge failed."); sys.exit(rc)
		print(f"\n{ARROW} {BGREEN('Auto-cleaning packages...')}")
		einfo("GNU info directory index is up-to-date.")

	# -- source builds (-b / --buildpkg, -B / --buildpkgonly) ----------------

	@staticmethod
	def _build_use():
		"""DEB_BUILD_OPTIONS is the closest thing Debian has to USE flags."""
		return os.environ.get("DEB_BUILD_OPTIONS",
		                      f"nocheck parallel={os.cpu_count()}")

	def _src_version(self, pkg):
		r = capture(["apt-cache", "showsrc", pkg])
		best = None
		for st in parse_stanzas(r.stdout):
			v = st.get("Version")
			if v and (best is None or vercmp(v, best) > 0):
				best = v
		return best

	def resolve_source(self, atoms, opts):
		merges, self._src_plan = [], []
		self._atoms = list(atoms)          # world candidates, for --oneshot
		use = self._build_use()
		for a in atoms:
			sv = self._src_version(a)
			if sv is None:
				raise RuntimeError(
				    f'there are no ebuilds to satisfy "{a}" -- no source '
				    f"package found. Your tree may lack deb-src entries; "
				    f"add them to /etc/apt/sources.list and `emerge --sync`.")
			newver = sv + "+local1"
			self._src_plan.append((a, sv, newver))
			merges.append((a, newver, self._installed_version(a),
			               0, "ebuild", use))
		# build dependencies appear as [binary], the way Portage shows binpkgs
		seen = {m[0] for m in merges}
		for a in atoms:
			r = capture(["apt-get", "-s", "-qq", "build-dep", a])
			if r.returncode != 0:
				raise RuntimeError((r.stderr or r.stdout).strip()
				                   .replace("E: ", ""))
			for line in r.stdout.splitlines():
				m = re.match(r"^Inst ([^\s:]+)(?::\S+)?(?: \[([^\]]+)\])? \((\S+) ", line)
				if m and m.group(1) not in seen:
					seen.add(m.group(1))
					merges.append((m.group(1), m.group(3), m.group(2),
					               0, "binary", ""))
		sizes = self._sizes(sorted(seen))
		return [(n, nv, ov, sizes.get(n, 0) if k == "binary" else 0, k, u)
		        for n, nv, ov, _, k, u in merges]

	@staticmethod
	def _bump_changelog(srcdir, newver):
		"""Prepend a changelog entry so the build carries +local1 --
        higher than the repo version, so @world upgrades won't clobber it."""
		cl = os.path.join(srcdir, "debian", "changelog")
		# Same read-then-write-back shape as dispatch-conf, and the same
		# reasoning: a changelog is full of maintainer names, so it is the
		# most likely file in the tree to carry a byte the locale cannot
		# decode. Without this the bump raised UnicodeDecodeError instead.
		with open(cl, encoding="utf-8", errors="surrogateescape") as f:
			old = f.read()
		m = re.match(r"^(\S+) \(([^)]+)\)", old)
		if m is None:
			raise RuntimeError(
			    f"cannot read the source name from {cl}: its first line is "
			    f"not a changelog header. Refusing to guess.")
		entry = (f"{m.group(1)} ({newver}) unstable; urgency=medium\n\n"
		         f"  * Local rebuild by emerge.\n\n"
		         f" -- emerge <root@localhost>  "
		         f"{email.utils.formatdate(localtime=True)}\n\n")
		with open(cl, "w", encoding="utf-8", errors="surrogateescape") as f:
			f.write(entry + old)

	def build(self, opts):
		need_root()
		os.makedirs(BINPKGS, exist_ok=True)
		use = self._build_use()
		installed = []
		# snapshot before anything is installed, for the mark fix-up below
		was_manual = self._manual_set()
		env = {**os.environ, "DEB_BUILD_OPTIONS": use,
		       "DEBIAN_FRONTEND": "noninteractive"}
		total = len(self._src_plan)
		for i, (atom, srcver, newver) in enumerate(self._src_plan, 1):
			pv = f"{atom}-{newver}"
			print(f"\n{ARROW} Emerging ({i} of {total}) {BGREEN(pv)}")
			einfo(f"Installing build dependencies for {atom} "
			      f"(oneshot: --depclean removes them again)...")
			r = capture(["apt-get", "-y", "build-dep", atom])
			if r.returncode != 0:
				print(r.stderr, file=sys.stderr)
				print(f"{RED('!!!')} build-dep failed for {atom}")
				sys.exit(1)
			portage_dir = os.path.join(PORTAGE_TMPDIR, f"{atom}-{srcver}")
			workdir = os.path.join(portage_dir, "work")
			shutil.rmtree(portage_dir, ignore_errors=True)
			os.makedirs(workdir)
			print(f"{ARROW} Unpacking source...")
			r = run(["apt-get", "source", atom], cwd=workdir,
			        capture_output=True)
			if r.returncode != 0:
				print(r.stderr, file=sys.stderr)
				print(f"{RED('!!!')} fetching source failed for {atom}")
				sys.exit(1)
			srcdir = next((os.path.join(workdir, d)
			               for d in sorted(os.listdir(workdir))
			               if os.path.isdir(os.path.join(workdir, d))), None)
			if srcdir is None:
				print(f"{RED('!!!')} apt-get source produced no source "
				      f"directory for {atom}")
				sys.exit(1)
			print(f"{ARROW} Source unpacked in {srcdir}")
			try:
				self._bump_changelog(srcdir, newver)
			except (RuntimeError, OSError) as e:
				print(f"{RED('!!!')} {e}")
				sys.exit(1)
			print(f"{ARROW} Compiling source in {BOLD(srcdir)} ...")
			proc = subprocess.Popen(
			    ["dpkg-buildpackage", "-b", "-uc", "-us"],
			    cwd=srcdir, env=env, stdout=subprocess.PIPE,
			    stderr=subprocess.STDOUT)
			for line in stream_lines(proc.stdout):
				print(line)
			try:
				proc.stdout.close()      # read to EOF; don't leak the pipe
			except OSError:
				pass
			if proc.wait() != 0:
				print(f"\n{RED('!!!')} {BOLD(f'compile failed for {atom}')}")
				sys.exit(1)
			print(f"{ARROW} Source compiled.")
			if "nocheck" in use.split():
				print(f"{ARROW} Test phase [not enabled]: {atom} "
				      f"(DEB_BUILD_OPTIONS did not request tests)")
			else:
				print(f"{ARROW} Test phase completed: {atom}")
			debs = sorted(f for f in os.listdir(workdir)
			              if f.endswith(".deb"))
			for d in debs:
				shutil.copy2(os.path.join(workdir, d), BINPKGS)
			print(f"{ARROW} Merging {len(debs)} binary package(s) to PKGDIR "
			      f"({BINPKGS}):")
			for d in debs:
				print(f"    {GREEN(d)}")
			if opts["buildpkgonly"]:
				continue
			noepoch = newver.split(":", 1)[-1]
			target = next((d for d in debs
			               if d.startswith(f"{atom}_{noepoch}_")), None)
			if target is None:
				print(f"{RED('!!!')} no .deb named {atom} among the products")
				sys.exit(1)
			r = capture(["apt-get", "-y", "install",
			             os.path.join(BINPKGS, target)])
			if r.returncode != 0:
				print(r.stderr, file=sys.stderr)
				print(f"{RED('!!!')} install failed for {atom}")
				sys.exit(1)
			installed.append(atom)
			print(f"{ARROW} Installing ({i} of {total}) {BGREEN(pv)}")
			print(f"{ARROW} Completed ({i} of {total}) {BGREEN(pv)}")
		print()
		if installed:
			self._apply_marks(was_manual, opts["oneshot"], named=installed)
		einfo("GNU info directory index is up-to-date.")
		# same as merge(): what we just installed has settled conffiles that
		# become the next ancestor, and parked ones have to be announced
		conf = load_conf()
		if installed:
			archive_settled(conf, installed)
		pending_notice(conf)

	@staticmethod
	def _manual_set():
		"""Packages apt records as manually installed -- i.e. @selected."""
		r = capture(["apt-mark", "showmanual"])
		return {l.strip() for l in r.stdout.splitlines() if l.strip()}

	def _named_packages(self):
		"""Package names this run puts on apt's own command line.

        apt marks every one of them manually installed, which is precisely
        what @selected is on this backend, so these are the names whose marks
        may need correcting afterwards."""
		return [a.split("=")[0] for a in (self._action or [])[1:]
		        if not a.startswith("-")]

	def _apply_marks(self, before, oneshot, named=None):
		"""Correct apt's manual-install marks after a merge.

        apt marks everything named on its command line as manually installed,
        and we name a great deal more than the user asked for: set members,
        and under --no-dep-upgrade the entire resolved closure as explicit
        version pins. Left alone, one `emerge --no-dep-upgrade libsdl3-dev`
        moved 32 dependencies into @world, where --depclean could never
        reclaim them again -- a leak with no way back short of apt-mark by
        hand.

        So everything we named that was not already manual goes back to auto,
        except the atoms the user actually typed. Under --oneshot those go
        back too, which is exactly what --oneshot means here. Packages that
        were already manual are never touched: neither flag has any business
        removing an entry that was in world before we started."""
		atoms = [a for a in getattr(self, "_atoms", []) if a not in before]
		keep = set() if oneshot else set(getattr(self, "_atoms", []))
		names = self._named_packages() if named is None else list(named)
		extra = sorted({p for p in names if p not in before and p not in keep})
		if extra:
			r = capture(["apt-mark", "auto"] + extra)
			if r.returncode != 0:
				ewarn("could not reset the manual-install mark: "
				      + (r.stderr or r.stdout).strip())
				ewarn(f"These stayed in @world: {', '.join(extra)}")
				return
		if not oneshot:
			print(f"{ARROW} Recording targets in \"world\" favorites file "
			      f"(apt manual-install marks)")
		elif atoms:
			print(f"{ARROW} Not recording targets in \"world\" favorites file "
			      f"(--oneshot): {', '.join(sorted(atoms))}")
		else:
			print(f"{ARROW} Not recording targets in \"world\" "
			      f"favorites file (--oneshot)")

	def deselect(self, names, pretend):
		"""Drop names from @selected without removing anything.

        @selected on this backend *is* `apt-mark showmanual`, so dropping a
        name means marking it auto -- the same call `--oneshot` already makes
        to undo the mark apt writes for every package on its command line.
        Hard rule 3 is untouched: a set membership is recorded, never a
        version, so nothing here can pin anything."""
		manual = self._manual_set()
		drop = [n for n in names if n in manual]
		# See the dpkg backend's copy: the permission check comes before the
		# announcement, or a non-root run claims to have done the work.
		if drop and not pretend:
			need_root()
		verb = "Would remove" if pretend else "Removing"
		for name in names:
			if name in manual:
				print(f"{ARROW} {verb} {BGREEN(name)} from "
				      f'"world" favorites file (apt manual-install marks)...')
			else:
				ewarn(f"{name} is not in @selected; skipping.")
		if drop and not pretend:
			r = capture(["apt-mark", "auto"] + drop)
			if r.returncode != 0:
				print((r.stderr or r.stdout).strip(), file=sys.stderr)
				eerror("could not clear the manual-install mark.")
				sys.exit(1)
		return drop

	@staticmethod
	def _policy_batch(names, chunk=500):
		"""{name: (installed, candidate)} for many packages in one go.

        `apt-cache policy` reports both, so this replaces two forks per
        result with one call per chunk. It matters: `emerge -s '^lib'`
        matches over 29,000 packages on Debian, and a fork each for the
        policy and the installed version made that search never finish."""
		out = {}
		for i in range(0, len(names), chunk):
			r = capture(["apt-cache", "policy"] + names[i:i + chunk])
			cur = None
			for line in r.stdout.splitlines():
				if line[:1] not in (" ", "\t") and line.rstrip().endswith(":"):
					cur = line.rstrip()[:-1].split(":")[0]   # drop :arch
					out.setdefault(cur, ("", ""))
				elif cur:
					m = re.match(r"\s+(Installed|Candidate):\s*(\S+)", line)
					if m:
						inst, cand = out[cur]
						if m.group(1) == "Installed":
							inst = m.group(2)
						else:
							cand = m.group(2)
						out[cur] = (inst, cand)
		return out

	def search(self, terms, desc):
		for term in terms:
			r = capture(["apt-cache", "search"]
			            + ([] if desc else ["--names-only"]) + [term])
			results = [l for l in r.stdout.splitlines() if l.strip()]
			print_search_header(term, len(results))
			policy = self._policy_batch([l.partition(" - ")[0]
			                             for l in results])
			for line in results:
				name, _, description = line.partition(" - ")
				inst, cand = policy.get(name, ("", ""))
				if not inst or inst == "(none)":
					inst = "[ Not Installed ]"
				print_search_hit(name, cand or "?", inst, description, 0)

# ---------------------------------------------------------------------------
# Shared search formatting
# ---------------------------------------------------------------------------

def print_search_header(term, n):
	print(f"{BLUE('[ Results for search key : ')}{BOLD(term)}{BLUE(' ]')}")
	print(f"{BLUE('[ Applications found : ')}{BOLD(str(n))}{BLUE(' ]')}\n")

def print_search_hit(name, avail, inst, desc, size):
	print(f"{GREEN('*')}  {BGREEN(name)}")
	print(f"      {GREEN('Latest version available:')} {avail}")
	print(f"      {GREEN('Latest version installed:')} {inst}")
	if size:
		print(f"      {GREEN('Size of files:')} {size / 1024:,.1f} KiB")
	print(f"      {GREEN('Description:')}   {desc}")
	print()

# ---------------------------------------------------------------------------
# CONFIG_PROTECT / dispatch-conf: deferred config-file merging
# ---------------------------------------------------------------------------
#
# Debian already parks updated config files beside the originals -- dpkg
# writes <file>.dpkg-dist, ucf writes <file>.ucf-dist -- which is exactly
# Portage's ._cfg0000_<file> mechanism under a different name. What Debian
# lacks is (a) a batched review tool, (b) an archive of the *previously
# shipped* version, and therefore (c) any hunk-level merging: dpkg can only
# offer whole-file choices.
#
# So: force dpkg to always defer (--force-confold --force-confdef), archive
# each package's as-shipped config files at merge time, and use last time's
# archive as the common ancestor for a real 3-way merge next time.

CONF_FILE      = "/etc/emerge/dispatch-conf.conf"
CONF_FILE_ALT  = "/etc/dispatch-conf.conf"
ARCHIVE_DIR    = "/var/lib/emerge/config-archive"
UCF_CACHE      = "/var/lib/ucf/cache"

DEFAULT_CONF = {
    "archive-dir":          ARCHIVE_DIR,
    "config-protect":       "/etc",
    "config-protect-mask":  "",
    "frozen-files":         "",
    "automerge":            "yes",   # apply conflict-free 3-way merges
    "replace-unmodified":   "yes",   # you never touched it -> take theirs
    "replace-wscomments":   "yes",   # only comments/whitespace differ
    "mergetool":            "",      # e.g. "meld {mine} {base} {theirs} -o {output}"
    "merge":                "",      # dispatch-conf compat: "cmd '%s' '%s' '%s'"
    "diff":                 "",      # external diff for display; empty = built-in
}

PENDING_SUFFIXES = (".dpkg-dist", ".dpkg-new", ".ucf-dist", ".ucf-new")
CFG_RE = re.compile(r"^\._cfg\d{4}_(?P<name>.+)$")

def load_conf():
	conf = dict(DEFAULT_CONF)
	for path in (CONF_FILE_ALT, CONF_FILE):        # /etc/emerge wins
		if not os.path.isfile(path):
			continue
		with open(path, errors="replace") as f:
			lines = f.readlines()
		for line in lines:
			line = line.strip()
			if not line or line.startswith("#") or "=" not in line:
				continue
			k, _, v = line.partition("=")
			k, v = k.strip(), v.strip()
			if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
				v = v[1:-1]
			if k in conf:
				conf[k] = v
	return conf

def conf_yes(conf, key):
	return conf.get(key, "no").lower() in ("yes", "true", "1", "on")

# -- pure-Python 3-way merge (diff3 -m equivalent) --------------------------

def _unchanged_map(base, other):
	"""base index -> index in `other`, for every base line that survived.

	A base line missing from this map is one that side changed."""
	out = {}
	matcher = difflib.SequenceMatcher(None, base, other, autojunk=False)
	for tag, i1, i2, j1, _j2 in matcher.get_opcodes():
		if tag == "equal":
			for k in range(i2 - i1):
				out[i1 + k] = j1 + k
	return out

def _sync_regions(base, mine, theirs):
	"""Regions where all three sequences agree, in ascending order.

	This is diff3's own definition of a stable region -- a run of base lines
	that *neither* side changed -- expressed directly: take the lines each
	side left alone, keep those both left alone, and group the runs that stay
	consecutive in all three.

	It replaced an equivalent formulation that intersected the two sets of
	matching blocks pairwise and then walked the result greedily, keeping
	only candidates that advanced in all three sequences. That guard turned
	out never to fire -- matching blocks are already ordered in both of their
	sequences, so the intersections are too -- and a correctness check that
	cannot fail is worse than none, because the next reader trusts it.
	Measured before replacing: identical output on 5,500 random merges
	across both realistic and adversarial input."""
	to_mine = _unchanged_map(base, mine)
	to_theirs = _unchanged_map(base, theirs)
	out = []
	for b in range(len(base)):
		m = to_mine.get(b)
		t = to_theirs.get(b)
		if m is None or t is None:
			continue                      # one side changed this line
		if out:
			lo, hi, m0, t0 = out[-1]
			if hi == b and m0 + (b - lo) == m and t0 + (b - lo) == t:
				out[-1] = (lo, b + 1, m0, t0)
				continue                  # extends the region in progress
		out.append((b, b + 1, m, t))
	return out

def merge3(base, mine, theirs, labels=("current", "as-shipped", "new")):
	"""Three-way line merge. Returns (merged_lines, conflict_count).

    The rules are `diff3 -m`'s, and they hold exactly: a region changed on
    only one side is taken from that side, an identical change on both sides
    is taken once, an unchanged region is kept, and real divergence gets
    conflict markers. Those four are property-tested against tens of
    thousands of random inputs.

    It is **not** byte-identical to `diff3 -m`, and once claimed to be.
    Measured on config-shaped input: 96% identical, and the 4% that differ
    were investigated rather than assumed.

    In every divergent case the two underlying 2-way diffs were *identical*
    to GNU diff's, so the alignment is not the cause and no better diff
    fixes it. Two rewrites were tried and both produced byte-identical
    output to what is here: computing stable regions diff3's own way, as the
    complement of the two change sets, and replacing difflib with a minimal
    Myers diff. Neither changed a single merge.

    What the remainder is, classified over 85 divergent merges:

      57  diff3 emits a conflict with no ancestor section at all, for a
          change both sides made identically
       8  diff3 conflicts although mine and theirs are the same text
      20  both conflict, over differently chosen but equally valid regions

    So three quarters of the difference is diff3 producing output worse than
    this does -- for `base=[a, c], mine=[Y], theirs=[Y]` it reports a
    conflict where the answer is plainly Y. Matching it byte-for-byte would
    mean reproducing that, and is not a goal. The four rules above are the
    contract; diff3 is a reference for them, not an oracle."""
	regions = _sync_regions(base, mine, theirs)
	regions.append((len(base), len(base), len(mine), len(theirs)))
	out, conflicts = [], 0
	bi = mi = ti = 0
	for lo, hi, m0, t0 in regions:
		b, m, t = base[bi:lo], mine[mi:m0], theirs[ti:t0]
		if m == b:
			out.extend(t)                     # only they changed it
		elif t == b:
			out.extend(m)                     # only you changed it
		elif m == t:
			out.extend(m)                     # both made the same change
		elif not (b or m or t):
			pass
		else:
			conflicts += 1
			out.append(f"<<<<<<< {labels[0]}\n")
			out.extend(m)
			out.append(f"||||||| {labels[1]}\n")
			out.extend(b)
			out.append("=======\n")
			out.extend(t)
			out.append(f">>>>>>> {labels[2]}\n")
		out.extend(base[lo:hi])
		bi, mi, ti = hi, m0 + (hi - lo), t0 + (hi - lo)
	return out, conflicts

def _significant(lines):
	"""Lines with comments and whitespace noise removed, for comparison."""
	out = []
	for l in lines:
		s = l.strip()
		if not s or s[0] in "#;" or s.startswith("//"):
			continue
		out.append(" ".join(s.split()))
	return out

def read_lines(path):
	"""A config file's lines, losslessly.

    `errors="replace"` was wrong here in a way that only shows up on the
    write side. A byte that is not valid UTF-8 -- a latin-1 accent in a
    comment, say -- decodes to U+FFFD, and _write then stores *that*, so a
    round trip through dispatch-conf silently rewrote the byte and there is
    no way back. surrogateescape keeps the original byte in the string and
    puts it back byte-for-byte on the way out.

    It also stops depending on the locale: without an explicit encoding,
    what a file means is whatever LANG happened to say. CPython's UTF-8
    mode hides that for the C locale, which is the case anybody would test,
    and not for the latin-1 locales it does not cover."""
	try:
		with open(path, encoding="utf-8", errors="surrogateescape") as f:
			return f.readlines()
	except OSError:
		return None

def printable(line):
	"""A line safe to print, whatever bytes it came from.

    Reading losslessly means a byte that is not valid UTF-8 stays in the
    string as a lone surrogate, and print() cannot encode one: it raises
    UnicodeEncodeError unless stdout happens to be in UTF-8 mode. That would
    take down the review at the moment it displayed the file -- worse than
    the corruption it replaced, and on the same files. Show the original
    byte escaped instead."""
	return line.encode("utf-8", "surrogateescape") \
	           .decode("utf-8", "backslashreplace")


def color_diff(a, b, fromfile, tofile):
	for line in difflib.unified_diff(a, b, fromfile, tofile, lineterm="\n"):
		line = printable(line.rstrip("\n"))
		if line.startswith("+"):   print(GREEN(line))
		elif line.startswith("-"): print(RED(line))
		elif line.startswith("@"): print(BCYAN(line))
		else:                      print(line)

# -- archive of as-shipped versions (the ancestor) --------------------------

def archive_path(conf, path):
	return os.path.join(conf["archive-dir"], path.lstrip("/"))

def conffiles_of(packages, chunk=500):
	"""{package: [config file, ...]} for many packages in one dpkg-query.

    Batched rather than one call per package. A fork each costs ~50ms, so a
    1500-package dist-upgrade spent well over a minute doing nothing but
    starting processes -- on the failure path as well as the success one.
    Same lesson as _policy_batch: on Debian the package count is the scale
    that matters, and per-package forks do not survive it.

    dpkg-query renders ${Conffiles} with its first entry on the package's own
    line and the rest indented beneath, so the split has to follow that."""
	out = {}
	names = list(packages)
	for i in range(0, len(names), chunk):
		r = capture(["dpkg-query", "-W", "-f=${Package}:${Conffiles}\n"]
		            + names[i:i + chunk])
		cur = None
		for line in r.stdout.splitlines():
			if line[:1].isspace():
				rest = line
			elif ":" in line:
				cur, _, rest = line.partition(":")
				out.setdefault(cur, [])
			else:
				# Neither a "<package>:" header nor an indented conffile.
				# Skipping rather than treating it as a header matters: a
				# stray line would otherwise become the current package and
				# every conffile after it would be filed under the wrong one
				# -- or, for a blank line, under "".
				continue
			if cur is None:
				continue
			parts = rest.split()
			# dpkg marks a dropped conffile with a trailing "obsolete"
			if parts and parts[0].startswith("/") \
			   and "obsolete" not in parts[-1:] and parts[0] not in out[cur]:
				out[cur].append(parts[0])
	return out

def pkg_conffiles(pkg):
	"""Config files dpkg tracks for one installed package."""
	return conffiles_of([pkg]).get(pkg, [])

def _store_ancestor(conf, target, source):
	dest = archive_path(conf, target)
	os.makedirs(os.path.dirname(dest), exist_ok=True)
	shutil.copy2(source, dest)

def archive_settled(conf, packages):
	"""Record the as-shipped state of config files AFTER a merge.

    Timing matters: only files dpkg installed without parking (i.e. you had
    not modified them, so on-disk == as-shipped) are archived here. Files
    that were parked deliberately keep their older archive entry -- that is
    precisely the ancestor dispatch-conf needs -- and are re-archived from
    the parked copy once resolved."""
	n = 0
	failed = []
	for paths in conffiles_of(packages).values():
		for path in paths:
			if any(os.path.exists(path + s) for s in PENDING_SUFFIXES):
				continue
			if os.path.isfile(path):
				# One file that cannot be copied must not take the rest with
				# it. This runs *after* a successful install and again from
				# the failure path, where its whole job is to record what
				# landed and announce parked files before bailing out -- so
				# an exception here replaces the error the user needed with
				# a traceback, and abandons every conffile after the failing
				# one. A full /var during an install is the ordinary way in.
				#
				# Losing one ancestor is cheap by comparison: dispatch-conf
				# falls back to a 2-way review for that file and says so.
				try:
					_store_ancestor(conf, path, path)
				except OSError as e:
					failed.append((path, e.strerror or str(e)))
					continue
				n += 1
	if failed:
		ewarn(f"could not archive {len(failed)} config file(s); "
		      f"dispatch-conf will review those without an ancestor:")
		for path, why in failed[:5]:
			ewarn(f"  {path}: {why}")
		if len(failed) > 5:
			ewarn(f"  ... and {len(failed) - 5} more")
	return n

def ancestor_for(conf, path):
	"""Previously shipped content: our archive, else ucf's cache."""
	a = archive_path(conf, path)
	lines = read_lines(a)
	if lines is not None:
		return lines, "archive"
	lines = read_lines(os.path.join(UCF_CACHE, path.replace("/", ":")))
	if lines is not None:
		return lines, "ucf cache"
	return None, None

# -- scanning ---------------------------------------------------------------

def protected_dirs(conf):
	mask = conf["config-protect-mask"].split()
	return [d for d in conf["config-protect"].split()
	        if os.path.isdir(d)], mask

def masked(path, mask):
	return any(path == m or path.startswith(m.rstrip("/") + "/") for m in mask)

def scan_pending(conf):
	"""[(target_path, pending_path)] awaiting review."""
	dirs, mask = protected_dirs(conf)
	found = []
	for root_dir in dirs:
		for root, _, files in os.walk(root_dir):
			for fn in files:
				full = os.path.join(root, fn)
				target = None
				for suf in PENDING_SUFFIXES:
					if fn.endswith(suf):
						target = full[:-len(suf)]
						break
				m = CFG_RE.match(fn)
				if m:
					target = os.path.join(root, m.group("name"))
				if target and not masked(target, mask) \
				   and os.path.isfile(target):
					found.append((target, full))
	return sorted(set(found))

def pending_notice(conf):
	pend = scan_pending(conf)
	if not pend:
		return
	dirs = ", ".join(sorted({os.path.dirname(t) or "/" for t, _ in pend})[:3])
	print()
	ewarn(f"IMPORTANT: {len(pend)} config files in '{dirs}' need updating.")
	ewarn("Type `emerge --dispatch-conf` to merge these files.")

# -- the review workflow ----------------------------------------------------

def run_mergetool(conf, base, mine, theirs, output):
	"""Hand off to a user-configured tool. Supports named placeholders and
    dispatch-conf's positional '%s' order (output, mine, theirs)."""
	tmpl = conf["mergetool"] or conf["merge"]
	if not tmpl:
		return False
	# A template is user-written configuration, so it can be wrong. Both
	# substitutions raise on a template that does not match: `mergetool=meld`
	# with no placeholders at all made "meld" % (a, b, c) a TypeError, which
	# crashed dispatch-conf outright -- in the middle of a review, with files
	# already retired and no summary of what had been decided.
	try:
		if "{" in tmpl:
			cmd = tmpl.format(base=shlex.quote(base or "/dev/null"),
			                  mine=shlex.quote(mine),
			                  theirs=shlex.quote(theirs),
			                  output=shlex.quote(output))
		else:
			# No quoting here on purpose: this is dispatch-conf's positional
			# form and its templates quote the placeholders themselves
			# ("... '%s'"), so quoting again would nest quotes and split
			# paths containing spaces into two arguments. Use the {named}
			# form for safe quoting.
			cmd = tmpl % (output, mine, theirs)
	except (TypeError, ValueError, KeyError, IndexError) as e:
		eerror(f"cannot use the configured mergetool -- {e}")
		eerror(f"  template: {tmpl}")
		eerror("  expected either {output}/{mine}/{theirs}/{base}, or "
		       "dispatch-conf's three positional '%s'.")
		return False
	return subprocess.call(cmd, shell=True) == 0

def _fsync_dir(path):
	"""Make a rename durable. The file's own fsync does not cover the
    directory entry, so without this the replace itself can still be lost."""
	try:
		fd = os.open(os.path.dirname(path) or "/", os.O_RDONLY)
	except OSError:
		return
	try:
		os.fsync(fd)
	except OSError:
		pass
	finally:
		os.close(fd)

def _copy_xattrs(src, dst):
	"""Carry extended attributes across a replacement.

    os.replace swaps in a different inode, so a freshly written file starts
    with none of what the original carried outside the stat struct: SELinux
    labels, POSIX ACLs, file capabilities. An /etc file that comes back
    without its label can stop being readable by the one daemon that needs
    it, and nothing about the merge would suggest why."""
	if not hasattr(os, "listxattr"):
		return
	try:
		names = os.listxattr(src)
	except OSError:
		return
	for name in names:
		try:
			os.setxattr(dst, name, os.getxattr(src, name))
		except OSError:
			pass                     # unprivileged, or the fs has no room

def _write(path, lines):
	"""Replace in place, preserving mode/owner of the existing file.

    Durability matters more here than anywhere else in the script: this is
    the step that installs a merged file into /etc. os.replace is atomic
    against a concurrent reader but not against power loss -- without the
    fsync the file can come back empty afterwards, and an empty sshd_config
    is worse than either version we were choosing between."""
	# A conffile is quite often a symlink. An admin pointing /etc/foo at a
	# git-managed tree is the usual reason; Debian's own alternatives system
	# is another. os.replace would swap the LINK itself for a regular file,
	# with two silent consequences: the indirection disappears, and the
	# merged content lands at the link's name while the file it pointed at
	# keeps the old text -- so the admin's source of truth goes stale and
	# their next edit of it changes nothing.
	#
	# Resolving first is also what the rest of this function already assumed.
	# os.stat follows symlinks, so the mode and owner being preserved so
	# carefully below were the TARGET's all along, and were being applied to
	# the regular file that replaced the link.
	#
	# What this does not preserve is a hard link: os.replace swaps in a new
	# inode, so a conffile with a second link to it will diverge. That is
	# not fixable without giving up the atomic replace, which is a much worse
	# trade for /etc than a broken hard link is.
	path = os.path.realpath(path)
	st = os.stat(path)
	def carry_metadata(tmp):
		"""What os.replace would otherwise drop on the floor."""
		os.chmod(tmp, st.st_mode)
		try:
			os.chown(tmp, st.st_uid, st.st_gid)
		except PermissionError:
			pass
		_copy_xattrs(path, tmp)

	# Paired with read_lines: surrogateescape on both sides is what makes a
	# byte that is not valid UTF-8 survive the round trip instead of being
	# replaced by U+FFFD and written into /etc that way. Encoding here
	# rather than opening in text mode, because the shared writer works in
	# bytes -- the same codec and the same errors setting, so the round trip
	# is unchanged.
	#
	# The temporary file keeps its own suffix. `.emerge-tmp` in /etc says
	# whose it is, where a bare `.tmp` beside somebody's config does not.
	write_atomic(path, "".join(lines).encode("utf-8", "surrogateescape"),
	             prepare=carry_metadata, suffix=".emerge-tmp")

def _retire(conf, target, pending):
	"""The parked file is what the package now ships: it becomes the ancestor
    for the next upgrade, whatever the user decided to keep on disk."""
	_store_ancestor(conf, target, pending)
	os.unlink(pending)

def _accept(conf, target, pending, lines):
	_write(target, lines)
	_retire(conf, target, pending)
	einfo(f"Updated {BGREEN(target)}")

def dispatch_conf(opts):
	need_root()
	conf = load_conf()
	frozen = conf["frozen-files"].split()
	pend = scan_pending(conf)
	if not pend:
		einfo("Nothing to merge; all config files are up to date.")
		return
	print(f"{BGREEN(' * ')}{len(pend)} config file(s) awaiting review.\n")
	auto = skipped = 0

	for target, pending in pend:
		mine = read_lines(target)
		theirs = read_lines(pending)
		if mine is None or theirs is None:
			continue

		if mine == theirs:
			_retire(conf, target, pending)
			auto += 1
			continue
		if target in frozen:
			_retire(conf, target, pending)
			ewarn(f"{target} is frozen; update discarded.")
			auto += 1
			continue

		base, src = ancestor_for(conf, target)

		if base is not None and mine == base and conf_yes(conf,
		                                                  "replace-unmodified"):
			_accept(conf, target, pending, theirs)
			print(f"    {GREEN('unmodified locally -- took the new version')}")
			auto += 1
			continue

		if conf_yes(conf, "replace-wscomments") and \
		   _significant(mine) == _significant(theirs):
			_accept(conf, target, pending, theirs)
			print(f"    {GREEN('comments/whitespace only -- auto-applied')}")
			auto += 1
			continue

		merged, conflicts = (None, 0)
		if base is not None:
			merged, conflicts = merge3(base, mine, theirs)
			if conflicts == 0 and conf_yes(conf, "automerge"):
				_accept(conf, target, pending, merged)
				print(f"    {GREEN('3-way merge clean -- auto-merged')} "
				      f"(ancestor: {src})")
				auto += 1
				continue

		# interactive
		print(f"\n{BLUE('=' * 72)}")
		print(f"{BOLD(target)}")
		if base is None:
			ewarn("no archived ancestor yet -- 2-way review only "
			      "(3-way merging starts from the next upgrade)")
		elif conflicts:
			ewarn(f"3-way merge against {src}: "
			      f"{RED(str(conflicts))} conflict(s) need a decision")
		print(f"{BLUE('=' * 72)}")
		color_diff(mine, theirs, target, pending)

		while True:
			print(f"\n{BGREEN(' * ')}File: {BOLD(target)}")
			opts_txt = [
			    f"  {GREEN('1)')} keep your current version (discard update)",
			    f"  {GREEN('2)')} use the new version (overwrite yours)",
			]
			if merged is not None:
				opts_txt.append(f"  {GREEN('3)')} use the merged version"
				                + (f" ({RED('has conflict markers')})"
				                   if conflicts else ""))
				opts_txt.append(f"  {GREEN('4)')} edit the merged version "
				                f"($EDITOR)")
			opts_txt.append(f"  {GREEN('5)')} launch mergetool")
			opts_txt.append(f"  {GREEN('6)')} show the diff again")
			opts_txt.append(f"  {GREEN('s)')} skip this file")
			opts_txt.append(f"  {GREEN('q)')} quit")
			print("\n".join(opts_txt))
			try:
				choice = input("Action: ").strip().lower()
			except (EOFError, KeyboardInterrupt):
				print(); choice = "q"

			if choice == "1":
				_retire(conf, target, pending)
				einfo(f"Kept {target}")
				break
			if choice == "2":
				_accept(conf, target, pending, theirs)
				break
			if choice == "3" and merged is not None:
				_accept(conf, target, pending, merged)
				break
			if choice == "4" and merged is not None:
				editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") \
				         or "vi"
				with tempfile.NamedTemporaryFile("w", suffix=".merge",
				                                 encoding="utf-8",
				                                 errors="surrogateescape",
				                                 delete=False) as tf:
					tf.writelines(merged)
					tmp = tf.name
				subprocess.call([editor, tmp])
				edited = read_lines(tmp)
				os.unlink(tmp)
				if edited:
					_accept(conf, target, pending, edited)
					break
			elif choice == "5":
				if not (conf["mergetool"] or conf["merge"]):
					eerror("no mergetool configured; set mergetool= in "
					       f"{CONF_FILE}")
					continue
				with tempfile.TemporaryDirectory() as td:
					bfile = os.path.join(td, "base")
					out = os.path.join(td, "out")
					if base is not None:
						# close it before the mergetool reads it -- relying on
						# the handle being collected to flush is only true by
						# accident of refcounting
						with open(bfile, "w", encoding="utf-8",
						          errors="surrogateescape") as bf:
							bf.writelines(base)
					else:
						bfile = None
					shutil.copy2(target, out)
					seeded = read_lines(out)
					if run_mergetool(conf, bfile, target, pending, out):
						res = read_lines(out)
						if res and res != seeded:
							_accept(conf, target, pending, res)
							break
						if res == seeded:
							# The output file is seeded with your current
							# version so the tool has something to edit. A
							# tool that exits 0 without writing would
							# otherwise have that seed accepted back as if it
							# were a merge result -- silently "merging" to
							# exactly what you already had.
							eerror("mergetool exited without changing the "
							       "output; nothing applied. Choose 1 to "
							       "keep your version deliberately.")
							continue
					eerror("mergetool did not produce a result.")
			elif choice == "6":
				color_diff(mine, theirs, target, pending)
			elif choice == "s":
				skipped += 1
				break
			elif choice == "q":
				print()
				einfo(f"{auto} file(s) handled automatically, "
				      f"{skipped} skipped; the rest remain pending.")
				return

	print()
	einfo(f"{auto} file(s) handled automatically, {skipped} skipped.")
	left = len(scan_pending(conf))
	if left:
		ewarn(f"{left} config file(s) still need attention.")
	else:
		einfo("All config files are up to date.")

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

HELP = f"""
Usage:
   emerge [ options ] [ action ] [ package | @set ] [ ... ]
   emerge [ options ] [ action ] < @system | @selected | @world >
   emerge < --sync | --version >
   emerge --help

Help (this screen):
   --help (-h)   Displays this help.

Actions:
   --depclean (-c)
                 Cleans the system by removing packages that are not
                 associated with explicitly merged packages. Depclean works
                 by creating the full dependency tree from the @world set,
                 then comparing it to installed packages. Packages installed,
                 but not part of the dependency tree, will be uninstalled by
                 depclean. Inspect the list with --pretend first. On the apt
                 backend this delegates to `apt-get autoremove`, and apt's
                 auto/manual-install marks are the source of truth; on the
                 dpkg backend the world file is.

   --deselect
                 Removes the given packages from the @selected set without
                 unmerging anything. Use it when a package should stay
                 installed but no longer count as something you asked for,
                 and to clear an entry naming a package that is gone from
                 the archive -- --unmerge cannot, since it skips whatever is
                 not installed. On the apt backend this marks the package
                 auto-installed; on the dpkg backend it edits the world
                 file. Combine with --pretend to see what would change.

   --dispatch-conf
                 Reviews and merges config files left pending by a merge.
                 Debian parks updated config files beside the originals
                 (<file>.dpkg-dist from dpkg, <file>.ucf-dist from ucf) --
                 the same idea as Portage's ._cfg0000_<file>, which is also
                 recognised. emerge archives each package's as-shipped
                 config files at merge time, so the previously shipped
                 version serves as the common ancestor for a true 3-way
                 merge of your edits against the new upstream version.
                 Files you never modified, differences that are only
                 comments or whitespace, and conflict-free merges are
                 applied automatically; only genuine conflicts are put to
                 you, with keep / replace / merged / $EDITOR / mergetool
                 choices. Also reachable as `etc-update`, and by symlinking
                 this script to dispatch-conf or etc-update.
                 Configured by {CONF_FILE} (or
                 {CONF_FILE_ALT}), keys:
                 archive-dir, config-protect, config-protect-mask,
                 frozen-files, automerge, replace-unmodified,
                 replace-wscomments, and mergetool -- e.g.
                 mergetool="meld {{mine}} {{base}} {{theirs}} -o {{output}}"
                 or dispatch-conf's own positional form
                 merge="sdiff --suppress-common-lines --output='%s' '%s' '%s'"

   --search (-s) Searches for matches of the supplied string in the synced
                 tree. The search string is a case-insensitive regular
                 expression matched against package names.

   --searchdesc (-S)
                 Matches the search string against the description field as
                 well as the package name.

   --sync        Updates the package tree. On the apt backend this runs
                 `apt-get update`. On the dpkg backend this downloads the
                 Packages indexes named in /etc/apt/sources.list[.d] over
                 http(s):// or file:// into {TREE_DIR}; a
                 file:// flat entry pointing at a bare directory of .deb
                 files (e.g. a USB stick) gets an index generated for it
                 on the spot with dpkg-deb. Each downloaded index is checked
                 against the archive's signed Release file (see --no-verify).

   --no-verify   Skips signature checking during --sync on the dpkg backend.
                 By default each index is verified with gpgv against the
                 archive's InRelease (or Release plus Release.gpg), using the
                 keyring named by the entry's signed-by option, or every key
                 in /etc/apt/trusted.gpg.d otherwise; the index is then
                 checked against the SHA256 recorded in that signed Release.
                 A failed check aborts the sync. Missing signatures only
                 warn, so unsigned local repositories keep working.

   --unmerge (-C)
                 WARNING: This action can remove important packages! Removes
                 all matching packages. Essential and Priority: required
                 packages are refused; on the dpkg backend, removals that
                 would break reverse dependencies are refused unless --ask
                 is given.

   --version (-V)
                 Displays the version number of emerge, the active backend,
                 and the copyright and licence.

Options:
   --ask (-a)    Before performing the merge, display what packages will be
                 installed, in the same format as when using --pretend; then
                 ask whether to continue with the merge or abort.

   --backend=<apt|dpkg>
                 Force a backend. By default the apt backend is used when
                 apt-get is present, otherwise the dpkg backend (intended
                 for embedded systems that carry only dpkg). May also be
                 set with the EMERGE_BACKEND environment variable.

   --buildpkg (-b)
                 Build the target from its Debian source package and
                 install the result. Build dependencies are installed as
                 apt auto-installed packages, so a later --depclean removes
                 them again (Gentoo's --with-bdeps=n behaviour). The built
                 version is suffixed +local1 so that @world upgrades will
                 not silently clobber your build. DEB_BUILD_OPTIONS is
                 honoured and shown as USE flags in the merge list
                 (default: nocheck parallel=<nproc>). Requires deb-src
                 entries in the tree and the apt backend plus dpkg-dev /
                 build-essential; the dpkg backend is binary-only.

   --buildpkgonly (-B)
                 Build, but do not install. Products are kept in PKGDIR
                 ({BINPKGS}) -- e.g. for feeding a
                 file:// source consumed by dpkg-only boxes.

   --deep (-D)   This flag forces emerge to consider the entire dependency
                 tree of packages, instead of checking only the immediate
                 dependencies of the packages. Combined with --update and a
                 set, the whole dependency closure of the set is checked
                 for updates: `emerge -uD @world` is the full system
                 upgrade, and on the apt backend it maps to
                 `apt-get dist-upgrade`.

   --fetchonly (-f)
                 Instead of performing the merge, just perform the fetches
                 for all packages (main package as well as all
                 dependencies). On the dpkg backend downloads land in
                 {DISTFILES} and are verified
                 against the index's SHA256.

   --no-dep-upgrade
                 Choose, for each target, the newest available version
                 whose entire dependency closure is already satisfied by
                 what is installed -- so the merge pulls in genuinely new
                 dependencies but never *upgrades* one that is already
                 present. This avoids dragging up libc, systemd, the
                 kernel and similar packages (and the reboots they force)
                 just to install a leaf. Unlike a version pin it does not
                 freeze the graph: it searches older target versions until
                 one fits, and fails -- naming the dependency that formed
                 the wall -- if none does. Works on atoms and on @world;
                 the search is per-target, so on a large set it runs many
                 dependency simulations and can be slow.

                 When the only obstacle is a same-upstream Debian revision
                 bump (e.g. libgbm1 25.0.7-2 -> 25.0.7-2+deb13u1, a stable-
                 update rebuild of the same upstream), the wall says so, and
                 flags any session-critical package (Mesa, Xorg, Wayland,
                 display managers) whose rebuild could restart your desktop.
                 Under --ask you are then offered to allow just those
                 packages to move; otherwise use --with (below).

   --backtrack=<n>
                 How hard to search when a --no-dep-upgrade resolution is not
                 found first time (default 10; 0 disables the retry).

                 The first pass takes the first alternative of every `a | b`
                 dependency, as apt and dpkg do. If that reports a wall, and
                 the closure actually contained a choice of alternative, the
                 search runs again branching on those alternatives before the
                 wall is believed -- so a wall you are shown has survived an
                 exhaustive search, while a resolution that works first time
                 costs nothing extra. <n> also multiplies the step budget for
                 that second pass.

   --with <pkg[,pkg...]>
                 Under --no-dep-upgrade, permit these already-installed
                 packages to be upgraded, while everything else still gets
                 the no-upgrade treatment. Use it to accept a specific
                 revision bump the resolver walled on:
                 emerge --no-dep-upgrade --with libgbm1 libsdl3-dev

   --oneshot (-1)
                 Emerge as normal, but do not add the packages to the world
                 file for later updating. On the dpkg backend this skips the
                 world-file entry; on the apt backend, where @selected is
                 apt's set of manually-installed packages, the marks apt
                 writes are reset with `apt-mark auto`. Packages that were
                 already in world stay there -- this never removes an
                 existing entry, it only declines to add a new one.

   --pretend (-p)
                 Instead of actually performing the merge, simply display
                 what *would* have been installed if --pretend weren't
                 used. In the printout:
                 N = new (not yet installed)
                 U = updating (to another version)
                 D = downgrading (best version seems lower)
                 R = replacing (remerging same version)
                 Source builds (-b/-B) are listed as [ebuild]; pre-built
                 repository packages alongside them appear as [binary].

   --update (-u) Updates packages to the best version available. Without
                 --update, targets that are already installed and current
                 are re-merged (reinstalled), as in Gentoo. Targets that
                 are not yet installed are installed either way.

   --verbose (-v)
                 Expanded display: per-package download sizes and a total.

Sets:
   @world        @selected plus @system.
   @selected     The world file ({WORLD}) on the dpkg
                 backend; apt's manual-install marks (apt-mark showmanual)
                 on the apt backend. Explicitly merged atoms are recorded
                 here; set members and pulled-in dependencies are not.
   @system       Debian's Essential and Priority: required base packages --
                 the closest native equivalent of Gentoo's system set.
                 The bare words `world` and `system` are accepted aliases.

Debian notes:
   Repository configuration is read from /etc/apt/sources.list and
   /etc/apt/sources.list.d (both one-line and deb822 .sources formats).
   A .sources stanza carrying `Enabled: no` is skipped, as apt skips it.
   On apt-less systems, simply create one by hand -- plain `deb` lines
   work. The dpkg backend verifies the SHA256 of every fetched .deb
   against the index, and the index itself against the archive's signed
   Release file (see --sync and --no-verify above).
   --newuse (-N), --quiet (-q) and --tree (-t) are accepted for
   muscle-memory compatibility and ignored.

For more help consult the man page, emerge(1), if you installed the package;
otherwise this is it.
"""

LONG_FLAGS = {"--ask": "a", "--verbose": "v", "--pretend": "p", "--update": "u",
              "--deep": "D", "--newuse": "N", "--search": "s",
              "--searchdesc": "S", "--unmerge": "C", "--fetchonly": "f",
              "--oneshot": "1", "--quiet": "q",
              "--buildpkg": "b", "--buildpkgonly": "B"}

# A Portage category: lowercase words joined by hyphens, then a slash --
# app-misc/sl, sys-apps/portage, virtual/editor. Debian has no categories, so
# the part before the slash is noise here rather than a name.
CATEGORY_RE = re.compile(r"[a-z][a-z0-9]*(-[a-z0-9]+)*")
# Portage's version operators, and only when they LEAD. `sl=5.02-1+b1` is
# apt's own exact-version spelling and works; `=sl-5.02-1+b1` is Portage's
# and does not. The position is what tells them apart.
VERSION_OP_RE = re.compile(r"^(>=|<=|!=|~|=|>|<)")


def translate_atom(atom):
	"""A Portage atom in Debian's vocabulary, or a complaint that fits.

    The premise of this program is that emerge's command line works here, so
    the spellings a Portage user's fingers produce should not fall through
    to apt and come back in apt's words. `emerge app-misc/sl` answered
    "Unable to locate package app-misc" -- naming a package nobody asked
    for, and leaking which tool was really being driven.

    Returns `(name, complaint)`, where a complaint is a list of lines and
    means the atom cannot be run at all."""
	# A local .deb is a path, not an atom, and apt installs those directly.
	# Nothing below may touch a token with a slash in it until this is out
	# of the way, or `emerge ./sl.deb` becomes `emerge sl.deb`.
	if atom.startswith(("./", "../", "/")) or atom.endswith(".deb"):
		return atom, None

	if VERSION_OP_RE.match(atom):
		return atom, [
		    f"{atom}: that is a Portage version atom, and Debian spells it "
		    f"differently.",
		    "    an exact version:  emerge sl=5.02-1+b1",
		    "    the newest:        emerge sl",
		    "    Ranges (>=, <=) have no command-line equivalent here.",
		    "    --no-dep-upgrade is the tool for holding versions down.",
		]

	if "/" in atom:
		category, _, rest = atom.partition("/")
		if CATEGORY_RE.fullmatch(category) and rest and "/" not in rest:
			return rest, None

	return atom, None


def backend_name(forced):
	"""Which backend would be used, without constructing it.

	`emerge -V` wants only the name, and constructing the dpkg backend is
	not free -- it seeds the world file. A version query must not create
	state, so it asks this instead."""
	choice = forced or os.environ.get("EMERGE_BACKEND")
	if choice in ("apt", "dpkg"):
		return choice
	if choice:
		eerror(f"unknown backend '{choice}' (use apt or dpkg)"); sys.exit(1)
	return "apt" if shutil.which("apt-get") else "dpkg"

def pick_backend(forced, pretend=False):
	"""The backend for this run. `pretend` reaches the dpkg backend because
    constructing it seeds the world file, which a --pretend run must not
    write. The apt backend keeps @selected in apt's marks and creates
    nothing, so it does not need telling."""
	if backend_name(forced) == "apt":
		if not shutil.which("apt-get"):
			eerror("apt backend requested but apt-get not found."); sys.exit(1)
		return AptBackend()
	return DpkgBackend(pretend=pretend)

def main(argv):
	opts = {k: False for k in ("ask", "verbose", "pretend", "update", "deep",
	                           "fetchonly", "oneshot", "search", "searchdesc",
	                           "unmerge", "depclean", "deselect", "sync",
	                           "buildpkg", "buildpkgonly", "dispatch",
	                           "no_dep_upgrade", "no_verify")}
	pkgs, backend_flag = [], None
	if not argv:
		print(HELP); return
	for arg in argv:
		# First, before anything else claims the token: a bare `--with` takes
		# the very next argument, whatever it is. Testing this further down
		# was not enough -- every long option recognised above it consumed
		# its token first, so `--with --backtrack=5 pkg` silently ate `pkg`
		# as the allow-list and then reported "no targets given".
		if opts.get("_with_pending"):
			opts["_with_pending"] = False
			if arg.startswith("-"):
				eerror("--with requires a comma-separated package list, "
				       f"got the option '{arg}'.")
				sys.exit(1)
			opts.setdefault("allow", set())
			opts["allow"] |= {p for p in arg.split(",") if p}
			continue
		if arg.startswith("--backend="):
			backend_flag = arg.split("=", 1)[1]; continue
		if arg == "--sync":
			opts["sync"] = True; continue
		if arg == "--depclean":
			opts["depclean"] = True; continue
		if arg == "--deselect":
			opts["deselect"] = True; continue
		if arg in ("--dispatch-conf", "--etc-update", "--config-update"):
			opts["dispatch"] = True; continue
		if arg == "--no-dep-upgrade":
			opts["no_dep_upgrade"] = True; continue
		if arg == "--no-verify":
			opts["no_verify"] = True; continue
		if arg.startswith("--backtrack="):
			val = arg.split("=", 1)[1]
			if not val.isdigit():
				eerror("--backtrack takes a number of attempts, "
				       f"got '{val}'.")
				sys.exit(1)
			globals()["BACKTRACK"] = int(val)
			continue
		if arg == "--with" or arg.startswith("--with="):
			# --with pkg,pkg  or  --with=pkg,pkg : permit these installed
			# packages to move under --no-dep-upgrade
			if "=" in arg:
				val = arg.split("=", 1)[1]
			else:
				val = "\x00NEXT"     # consume next token
			opts.setdefault("allow", set())
			if val == "\x00NEXT":
				opts["_with_pending"] = True
			else:
				opts["allow"] |= {p for p in val.split(",") if p}
			continue
		if arg in ("--help", "-h"):
			print(HELP); return
		if arg in ("--version", "-V"):
			print(f"Portage {VERSION} (python {sys.version.split()[0]}, "
			      f"{backend_name(backend_flag)} backend)")
			print(f"emerge for Debian -- {COPYRIGHT}")
			print(f"Licence {LICENCE}: GNU GPL version 2 or later. This is "
			      f"free software;")
			print("there is NO WARRANTY, to the extent permitted by law.")
			return
		if arg in LONG_FLAGS:
			arg = "-" + LONG_FLAGS[arg]
		if arg.startswith("--"):
			# Nothing above recognised it. Short options already refuse
			# unknown letters; long ones used to fall through both branches
			# and vanish, so `--no-dep-upgrades` -- one letter off -- ran an
			# ordinary unprotected install without a word of complaint.
			eerror(f"unknown option: {arg}"); sys.exit(1)
		if arg.startswith("-") and len(arg) > 1:
			for ch in arg[1:]:
				if   ch == "a": opts["ask"] = True
				elif ch == "v": opts["verbose"] = True
				elif ch == "p": opts["pretend"] = True
				elif ch == "u": opts["update"] = True
				elif ch == "D": opts["deep"] = True
				elif ch == "s": opts["search"] = True
				elif ch == "S": opts["searchdesc"] = True
				elif ch == "C": opts["unmerge"] = True
				elif ch == "f": opts["fetchonly"] = True
				elif ch == "1": opts["oneshot"] = True
				elif ch == "c": opts["depclean"] = True
				elif ch == "b": opts["buildpkg"] = True
				elif ch == "B": opts["buildpkgonly"] = True
				elif ch in "Nqt": pass
				else:
					eerror(f"unknown option: -{ch}"); sys.exit(1)
		elif not arg.startswith("-"):
			if arg in ("world", "@world"):
				pkgs.append("@world")
			elif arg in ("system", "@system"):
				pkgs.append("@system")
			elif arg == "@selected":
				pkgs.append("@selected")
			elif arg.startswith("@"):
				# otherwise this falls through as an atom and the resolver
				# reports "no packages to satisfy @nosuchset", which answers
				# a question nobody asked
				eerror(f"unknown set: {arg} "
				       f"(known sets: @world, @selected, @system)")
				sys.exit(1)
			else:
				pkgs.append(arg)

	if opts.get("_with_pending"):
		eerror("--with requires a comma-separated package list."); sys.exit(1)

	# Portage spellings, before anything hands them to apt in its own words.
	translated, complaints = [], []
	for pkg in pkgs:
		name, complaint = translate_atom(pkg)
		translated.append(name)
		if complaint:
			complaints.extend(complaint)
	if complaints:
		for line in complaints:
			eerror(line)
		sys.exit(1)
	pkgs = translated

	if opts["dispatch"]:
		dispatch_conf(opts); return

	be = pick_backend(backend_flag, pretend=opts["pretend"])

	if opts["sync"]:
		# the apt backend's sync is apt-get update, which verifies on its own
		be.sync(**({} if be.name == "apt"
		           else {"verify": not opts["no_verify"]}))
		return
	if opts["searchdesc"] or opts["search"]:
		if not pkgs:
			eerror("no search terms given."); sys.exit(1)
		be.search(pkgs, opts["searchdesc"]); return

	if opts["depclean"]:
		calc_deps_start()
		removals = be.depclean_candidates()
		calc_deps_done()
		if not removals:
			print(f"\n{ARROW} No packages selected for removal by depclean")
			return
		print_unmerge_list(removals)
		if opts["pretend"]:
			return
		if opts["ask"] and not ask_continue("unmerge"):
			print("\nQuitting."); sys.exit(1)
		be.unmerge(removals); return

	if opts["deselect"]:
		if not pkgs:
			eerror("no targets given."); sys.exit(1)
		# Nothing matched means nothing was done, and `emerge -C` already
		# says so with a non-zero status when none of its targets were
		# installed. Two verbs that both mean "you named things I could not
		# act on" should not disagree about whether that is a failure.
		if not be.deselect(pkgs, opts["pretend"]):
			sys.exit(1)
		return

	if opts["unmerge"]:
		if not pkgs:
			eerror("no targets given."); sys.exit(1)
		removals = be.unmerge_candidates(pkgs, opts)
		if not removals:
			sys.exit(1)
		print_unmerge_list(removals, pkgs)
		if opts["pretend"]:
			return
		if opts["ask"] and not ask_continue("unmerge"):
			print("\nQuitting."); sys.exit(1)
		be.unmerge(removals); return

	# source builds (-b / -B): apt backend only, by design
	if opts["buildpkg"] or opts["buildpkgonly"]:
		if be.name != "apt":
			eerror("Source builds require the apt backend; the dpkg backend "
			       "is binary-only by design (a build system that large "
			       "deserves real apt).")
			eerror("Build on a host with -B and feed the .debs to a file:// "
			       "source instead.")
			sys.exit(1)
		if not pkgs or any(p.startswith("@") for p in pkgs):
			eerror("source builds take explicit package atoms, not sets.")
			sys.exit(1)
		calc_deps_start()
		try:
			merges = be.resolve_source(pkgs, opts)
		except RuntimeError as e:
			calc_deps_done(ok=False)
			print()
			eblock(str(e))
			sys.exit(1)
		calc_deps_done()
		if opts["pretend"] or opts["ask"] or opts["verbose"]:
			print("\nThese are the packages that would be merged, "
			      "in order:\n")
			print_merge_list(merges, opts["verbose"])
		if opts["pretend"]:
			return
		if opts["ask"] and not ask_continue():
			print("\nQuitting."); sys.exit(1)
		be.build(opts)
		return

	# merge
	if not pkgs:
		eerror("no targets given."); sys.exit(1)
	calc_deps_start()
	allow = opts.get("allow", set())
	try:
		merges = be.resolve(pkgs, update=opts["update"], deep=opts["deep"],
		                    no_dep_upgrade=opts["no_dep_upgrade"], allow=allow)
	except NduWall as w:
		calc_deps_done(ok=False)
		print()
		eblock(str(w))
		# Interactive escape hatch under -a: offer to allow the movers, and
		# keep offering. Packages that pin each other with '=' (the Mesa and
		# Qt stacks) surface one at a time, so a single retry dead-ends part
		# way through a stack that cannot be granted in one answer.
		if not opts["ask"]:
			sys.exit(1)
		while True:
			new_names = {m["name"] for m in w.movers} - allow
			if not new_names:
				# granting these changed nothing; asking again would loop
				eerror("--no-dep-upgrade: no progress is possible here.")
				sys.exit(1)
			crit = [m for m in w.movers if m["session_critical"]]
			if crit and not all(m["same_upstream"] for m in crit):
				print()
				ewarn("Some packages above are session-critical; allowing "
				      "them may close your running graphical session.")
			elif crit:
				print()
				einfo("Those are rebuilds of libraries your session is using: "
				      "it keeps running. Log out when convenient so "
				      "everything is on the new build.")
			names = ",".join(sorted(new_names))
			if not ask_yesno(f"\nAllow {BOLD(names)} to move and continue?"):
				print("\nQuitting."); sys.exit(1)
			allow = allow | new_names
			try:
				merges = be.resolve(pkgs, update=opts["update"],
				                    deep=opts["deep"],
				                    no_dep_upgrade=opts["no_dep_upgrade"],
				                    allow=allow)
			except NduWall as w2:
				print()
				eblock(str(w2))
				w = w2
				continue
			except RuntimeError as e:
				print(); eblock(str(e)); sys.exit(1)
			break
		# fall through to the normal ask/merge below with allow applied
		calc_deps_done()
		_finish_merge(be, merges, pkgs, opts)
		return
	except RuntimeError as e:
		calc_deps_done(ok=False)
		print()
		eblock(str(e))
		sys.exit(1)
	calc_deps_done()
	_finish_merge(be, merges, pkgs, opts)

def _finish_merge(be, merges, pkgs, opts):
	if not merges:
		einfo("No outdated packages were found on your system."
		      if any(p.startswith("@") for p in pkgs) else
		      "Nothing to merge; all targets are already up to date.")
		return
	if opts["pretend"] or opts["ask"] or opts["verbose"]:
		print("\nThese are the packages that would be merged, in order:\n")
		print_merge_list(merges, opts["verbose"])
	if opts["pretend"]:
		return
	if opts["ask"] and not ask_continue():
		print("\nQuitting."); sys.exit(1)
	be.merge(merges, pkgs, opts)

if __name__ == "__main__":
	# Die on a closed pipe the way every other Unix tool does. Python
	# ignores SIGPIPE and raises BrokenPipeError instead, which surfaces at
	# interpreter shutdown as "Exception ignored on flushing sys.stdout" plus
	# exit status 120 -- so `emerge -pv @world | head` printed a traceback
	# and returned an error for doing something entirely ordinary. This
	# script prints long package lists; piping them to head or less is how
	# people read them.
	try:
		import signal
		signal.signal(signal.SIGPIPE, signal.SIG_DFL)
	except (ImportError, AttributeError, ValueError):
		pass                      # no SIGPIPE here, or not the main thread
	try:
		# `ln -s emerge /usr/sbin/dispatch-conf` (or etc-update) just works
		_self = os.path.basename(sys.argv[0])
		_args = sys.argv[1:]
		if _self in ("dispatch-conf", "etc-update"):
			_args = ["--dispatch-conf"] + _args
		main(_args)
	except KeyboardInterrupt:
		print(f"\n\n{RED('!!!')} Interrupted."); sys.exit(130)
